#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != --on-host ]]; then
  repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
  change=bootstrap
  repair_of=none
  qualification=none
  reader_image=none
  codex_mapping=none
  if [[ "${1:-}" == --change && $# -ge 3 ]]; then
    change="$2"
    shift 2
    while (( $# >= 3 )); do
      case "$1" in
        --repair-of) [[ "$repair_of" == none ]]; repair_of="$2" ;;
        --qualification) [[ "$qualification" == none ]]; qualification="$2" ;;
        --reader-image) [[ "$reader_image" == none && "$2" =~ ^sha256:[0-9a-f]{64}$ ]]; reader_image="$2" ;;
        --codex-host-config) [[ "$codex_mapping" == none ]]; codex_mapping="$2" ;;
        *) break ;;
      esac
      shift 2
    done
    uuid_pattern='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
    [[ "$change" =~ $uuid_pattern && ( "$repair_of" == none || "$repair_of" =~ $uuid_pattern ) ]]
  fi
  if [[ $# != 1 || ! "$1" =~ ^[0-9a-f]{40}$ ]]; then
    printf 'usage: deploy/activate-release --change UUID [--repair-of UUID] [--qualification FILE] [--reader-image DIGEST] [--codex-host-config FILE] TARGET\n' >&2
    exit 64
  fi
  commit="$1"
  if ! git -C "$repo_dir" cat-file -e "$commit:deploy/qualified-reader" 2>/dev/null; then
    printf 'target lacks the named maintenance contract; use a qualified adr 0104 build\n' >&2
    exit 1
  fi
  tree="$(git -C "$repo_dir" rev-parse --verify "$commit^{tree}")"
  lock="$(git -C "$repo_dir" show "$commit:uv.lock" | shasum -a 256 | awk '{print $1}')"
  incoming=none
  if [[ "$reader_image" != none ]]; then
    local_proof="$(mktemp "${TMPDIR:-/tmp}/jarvis-reader.XXXXXX")"
    trap 'rm -f -- "$local_proof"' EXIT
    "$repo_dir/deploy/qualified-reader" "$reader_image" >"$local_proof"
  fi
  if [[ "$qualification" != none ]]; then
    python3 - "$qualification" <<'PYCODE'
import os
import stat
import sys

entry = os.lstat(sys.argv[1])
if not stat.S_ISREG(entry.st_mode) or entry.st_uid != os.getuid() or entry.st_mode & 0o077:
    raise SystemExit("select an owner-private rehearsal receipt")
if entry.st_size > 2 * 1024 * 1024:
    raise SystemExit("rehearsal receipt exceeds its maximum size")
PYCODE
  fi
  if [[ "$codex_mapping" != none ]]; then
    [[ -f "$codex_mapping" && ! -L "$codex_mapping" ]] || exit 64
  fi
  if [[ "$qualification" != none || "$reader_image" != none || "$codex_mapping" != none ]]; then
    incoming="$(ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy mktemp -d /tmp/jarvis-qualification.XXXXXX)"
    [[ "$incoming" =~ ^/tmp/jarvis-qualification\.[a-zA-Z0-9]+$ ]]
    if [[ "$qualification" != none ]]; then
      scp -q -o BatchMode=yes -o ForwardAgent=no "$qualification" "dev-server-deploy:$incoming/rehearsal.json"
    fi
    if [[ "$reader_image" != none ]]; then
      scp -q -o BatchMode=yes -o ForwardAgent=no "$local_proof" "dev-server-deploy:$incoming/reader.json"
    fi
    if [[ "$codex_mapping" != none ]]; then
      scp -q -o BatchMode=yes -o ForwardAgent=no "$codex_mapping" "dev-server-deploy:$incoming/codex-host.json"
    fi
  fi
  ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy \
    sudo -n bash -s -- "$commit" "$tree" "$lock" "$change" "$repair_of" "$incoming" <<'REMOTE'
set -euo pipefail
release="/opt/jarvis/releases/$1"
python3 - "$release/RELEASE.json" "$1" "$2" "$3" <<'PYCODE'
import json
import sys
from pathlib import Path

expected = dict(zip(("commit", "tree", "uv_lock_sha256"), sys.argv[2:], strict=True))
if json.loads(Path(sys.argv[1]).read_bytes()) != expected:
    raise SystemExit("installed receipt differs from externally selected release")
PYCODE
unit="jarvis-activate-$4-$RANDOM"
incoming=none
if [[ "$6" != none ]]; then
  [[ "$6" =~ ^/tmp/jarvis-qualification\.[a-zA-Z0-9]+$ ]]
  mkdir -p -m 0700 /var/lib/jarvis-cutover
  incoming="$(mktemp -d /var/lib/jarvis-cutover/.qualification-$4.XXXXXX)"
  for name in rehearsal.json reader.json codex-host.json; do
    if [[ -e "$6/$name" || -L "$6/$name" ]]; then
      [[ -f "$6/$name" && ! -L "$6/$name" ]]
      install -m 0600 -- "$6/$name" "$incoming/$name"
    fi
  done
  rm -rf -- "$6"
fi
result=0
systemd-run --quiet --wait --collect --unit="$unit" --property=Type=exec \
  /usr/bin/flock --exclusive /opt/jarvis/.deploy.lock \
  "$release/deploy/activate-release" --on-host "$1" "$4" "$5" "$incoming" || result=$?
journalctl --quiet --no-pager --output=cat --unit="$unit"
exit "$result"
REMOTE
  exit
fi

[[ $EUID == 0 && $# == 5 ]]
commit="$2"
change="$3"
repair_of="$4"
incoming="$5"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
release="/opt/jarvis/releases/$commit"
source "$release/deploy/release-functions"
custody="$release/deploy/cutover-hold"
rehearsal=none
incoming_reader=none
incoming_mapping=none
if [[ "$incoming" != none ]]; then
  [[ "$incoming" =~ ^/var/lib/jarvis-cutover/\.qualification-[0-9a-f-]+\.[a-zA-Z0-9]+$ ]]
  trap 'rm -rf -- "$incoming"' EXIT
  if [[ -f "$incoming/rehearsal.json" ]]; then rehearsal="$incoming/rehearsal.json"; fi
  if [[ -f "$incoming/reader.json" ]]; then incoming_reader="$incoming/reader.json"; fi
  if [[ -f "$incoming/codex-host.json" ]]; then incoming_mapping="$incoming/codex-host.json"; fi
fi

refuse() {
  printf '%s\n' "$1" >&2
  exit 1
}

schema_of() {
  "$1/.venv/bin/python" -c 'from jarvis.db import APPLICATION_SCHEMA_REVISION; print(APPLICATION_SCHEMA_REVISION)'
}

native_contract_of() {
  "$1/.venv/bin/python" -c 'from jarvis.native_protocol import NATIVE_REQUEST_SCHEMA; print(NATIVE_REQUEST_SCHEMA)'
}

persist() {
  local input="$1" path="$2"
  install -m 0600 -- "$input" "$path.tmp"
  sync -f "$path.tmp"
  mv -Tf "$path.tmp" "$path"
  sync -f "$path"
}

backup_hashes() {
  local path
  for path in /etc/jarvis/backup.json /etc/jarvis/backup-reader.json; do
    if [[ -f "$path" ]]; then
      sha256sum "$path" | cut -d' ' -f1
    else
      printf '%s\n' absent
    fi
  done
}

install_selection() {
  for unit in jarvis.service jarvis-memory.service jarvis-backup.service jarvis-backup.timer; do
    if [[ "$unit" == jarvis-backup.* && ! -f "/etc/systemd/system/$unit" ]]; then continue; fi
    case "$(systemctl is-enabled "$unit" || true)" in masked|masked-runtime) continue ;; esac
    install -m 0644 -o root -g root "$release/deploy/$unit" "/etc/systemd/system/$unit"
  done
  sync -f /etc/systemd/system
  systemctl daemon-reload
  local temporary="/opt/jarvis/.current-$commit"
  rm -f -- "$temporary"
  ln -s "releases/$commit" "$temporary"
  mv -Tf "$temporary" /opt/jarvis/current
  sync -f /opt/jarvis
}

target_schema="$(schema_of "$release")"
if [[ "$change" == bootstrap ]]; then
  require_no_cutover_hold
  [[ ! -e /opt/jarvis/current && ! -L /opt/jarvis/current ]] ||
    refuse "established releases require a named --change"
  [[ "$(check_release_schema "$release")" == "$target_schema" ]] ||
    refuse "bootstrap schema does not match the selected release"
  systemctl is-active --quiet jarvis-codex-contained.service
  check_source_activation "$release"
  install_selection
  systemctl enable --now jarvis-memory.service jarvis.service
  "$custody" verify-serving "$commit" jarvis-memory.service,jarvis.service
  prune_releases
  exit
fi

phase="$("$custody" status "$change")"
if [[ "$phase" == startup-failed ]]; then
  refuse "startup failed for $change. inspect its status and use a newly authorized --repair-of $change"
fi
if [[ "$phase" == committed || "$phase" == not-applied ]]; then
  retry=()
  if [[ "$rehearsal" != none ]]; then retry+=(--qualification "$rehearsal"); fi
  if [[ "$incoming_reader" != none ]]; then retry+=(--reader "$incoming_reader"); fi
  if [[ "$incoming_mapping" != none ]]; then retry+=(--mapping "$incoming_mapping"); fi
  "$custody" verify-release-retry "$change" "$commit" "$repair_of" "${retry[@]}"
  "$custody" start "$change"
  if [[ "$phase" == committed ]]; then prune_releases; else exit 1; fi
  exit
fi

source_commit="$("$custody" source "$change")"
source_release="/opt/jarvis/releases/$source_commit"
if [[ "$phase" == unknown ]]; then
  source_schema="$(schema_of "$source_release")"
else
  source_schema="$("$custody" source-schema "$change")"
fi
if [[ "$phase" == unknown && "$repair_of" != none ]]; then
  parent="$("$custody" repair-source "$repair_of")"
  mapfile -t prior <<<"$parent"
  observed="$(check_release_schema "$release")"
  [[ "$observed" == "$target_schema" ]] ||
    refuse "repair target must match the held database revision $observed; retry the original change for its migration"
  if [[ "$observed" != "$source_schema" ]]; then
    [[ "$source_commit" == "${prior[0]}" && "$source_schema" == "${prior[1]}" && "$observed" == "${prior[3]}" ]] ||
      refuse "held database and selected code require the exact predecessor migration receipt"
    previous_release="/opt/jarvis/releases/${prior[2]}"
    systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
      "--property=WorkingDirectory=$previous_release" \
      --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
      --property=EnvironmentFile=/etc/jarvis/migration.env \
      "$previous_release/.venv/bin/python" "$previous_release/deploy/prepare-cutover" \
      verify-target "$repair_of" "${prior[0]}" "${prior[2]}" "${prior[1]}" "${prior[3]}" \
      "/var/lib/jarvis-cutover/held/qualification-$repair_of.json" </dev/null
    source_schema="$observed"
  fi
fi
if [[ "$source_schema" == "$target_schema" && "$rehearsal" != none ]]; then
  refuse "schema is unchanged, so no migration qualification receipt applies"
fi

if [[ "$source_schema" == 0022 && "$target_schema" == 0023 ]]; then
  systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
    --property=User=jarvis --property=Group=jarvis \
    "--property=SupplementaryGroups=jarvis-memory" \
    --property=EnvironmentFile=/etc/jarvis/fcm.env \
    "$release/.venv/bin/python" - <<'PY'
import os
from jarvis.fcm import load_sender_account

try:
    load_sender_account(os.environ.get("JARVIS_FCM_PROJECT_ID"))
except Exception:
    raise SystemExit("the phone cut needs a valid dedicated FCM service account") from None
PY
fi

migration() {
  local step="$1"
  shift
  systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
    "--property=WorkingDirectory=$release" \
    --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
    --property=EnvironmentFile=/etc/jarvis/migration.env \
    "$release/.venv/bin/python" "$release/deploy/prepare-cutover" "$step" "$change" \
    "$source_commit" "$commit" "$source_schema" "$target_schema" "$@" </dev/null
}

mapping=/etc/jarvis/codex-host.json
[[ "$(stat -c '%U:%G:%a' "$mapping")" == root:root:644 ]] ||
  refuse "installed native mapping has unexpected ownership or mode"
units=jarvis.service,jarvis-memory.service,jarvis-codex-contained.service,jarvis-backup.service
held=/var/lib/jarvis-cutover/held
stored_mapping="$held/mapping-$change.json"
mapping_source="$mapping"
if [[ -f "$stored_mapping" ]]; then
  if [[ "$incoming_mapping" != none ]]; then
    cmp -s "$incoming_mapping" "$stored_mapping" || refuse "change $change already binds another Codex mapping"
  fi
  mapping_source="$stored_mapping"
elif [[ "$incoming_mapping" != none ]]; then
  mapping_source="$incoming_mapping"
fi
JARVIS_CODEX_HOST_CONFIG_PATH="$mapping_source" \
  "$release/.venv/bin/python" "$release/deploy/codex-host" verify-agy
mapping_digest="$(sha256sum "$mapping_source" | cut -d' ' -f1)"
digest="$mapping_digest"
stored_reader="$held/reader-$change.json"
backup_facts="$held/backup-facts-$change.json"
reader="$incoming_reader"
if [[ -f "$stored_reader" ]]; then
  if [[ "$incoming_reader" != none ]]; then
    cmp -s "$incoming_reader" "$stored_reader" || refuse "change $change already binds another reader proof"
  fi
  reader="$stored_reader"
fi
backup_config=/etc/jarvis/backup.json
if [[ "$reader" != none ]]; then
  [[ -f "$backup_config" ]] || refuse "no backup is configured for reader replacement"
  "$release/.venv/bin/python" "$release/deploy/qualified-reader" check "$release" "$reader" >/dev/null
  reader_digest="$(sha256sum "$reader" | cut -d' ' -f1)"
  digest="$(printf '%s\n' "$mapping_digest" "$reader_digest" | sha256sum | cut -d' ' -f1)"
elif [[ -f "$backup_config" ]]; then
  "$release/.venv/bin/python" "$release/deploy/qualified-reader" current "$release" >/dev/null ||
    refuse "configured backup needs a qualified target --reader-image; installed reader proof is missing or mismatched"
fi
repair=()
if [[ "$repair_of" != none ]]; then repair=(--repair-of "$repair_of"); fi
if [[ "$phase" == unknown && "$repair_of" == none ]]; then
  require_no_cutover_hold
  if [[ "$(systemctl is-enabled jarvis-codex-contained.service)" != enabled ]] ||
      ! systemctl is-active --quiet jarvis-codex-contained.service; then
    refuse "contained host needs an explicit intended state before release replacement"
  fi
fi
phase="$("$custody" begin "$change" release "$source_commit" "$commit" "$digest" "$units" \
  --source-schema "$source_schema" --target-schema "$target_schema" --idle-check "${repair[@]}")"
case "$phase" in held|applying) ;; *) refuse "custody returned an unexpected phase for $change" ;; esac

report_hold() {
  if [[ -d /var/lib/jarvis-cutover/held ]]; then
    printf 'held %s. selected release %s. inspect the stopped operation before retrying.\n' \
      "$change" "$(basename "$(readlink -e /opt/jarvis/current)")" >&2
  fi
}
trap report_hold ERR

observed_schema="$(check_release_schema "$release")"
[[ "$observed_schema" == "$source_schema" || ( "$phase" == applying && "$observed_schema" == "$target_schema" ) ]] ||
  refuse "held $change. selected database schema changed"
umask 077
scratch="$(mktemp -d /tmp/jarvis-activation.XXXXXX)"
trap 'rm -rf -- "$scratch"; if [[ "$incoming" != none ]]; then rm -rf -- "$incoming"; fi' EXIT
if [[ "$mapping_source" != "$mapping" ]]; then
  if [[ ! -f "$stored_mapping" ]]; then persist "$mapping_source" "$stored_mapping"; fi
  mapping_source="$stored_mapping"
fi
[[ "$(sha256sum "$mapping_source" | cut -d' ' -f1)" == "$mapping_digest" ]] ||
  refuse "held $change. staged native mapping changed"
if [[ "$reader" != none ]]; then
  if [[ ! -f "$stored_reader" ]]; then persist "$reader" "$stored_reader"; fi
  if [[ ! -f "$backup_facts" ]]; then
    "$release/.venv/bin/python" "$release/deploy/qualified-reader" facts "$release" "$stored_reader" >"$scratch/backup.json"
    persist "$scratch/backup.json" "$backup_facts"
  fi
else
  backup_hashes >"$scratch/backup.sha256"
  if [[ ! -f "$held/backup-before-$change.sha256" ]]; then
    persist "$scratch/backup.sha256" "$held/backup-before-$change.sha256"
  fi
  cmp -s "$scratch/backup.sha256" "$held/backup-before-$change.sha256" || refuse "held $change. backup declaration changed"
fi
printf '%s\n' '{"authority_changes":[]}' >"$scratch/unchanged-authority.json"
preflight_release="$release"
if ! cmp -s "$mapping" "$mapping_source"; then
  # This is the last stopped check against the predecessor's own account
  # contract. The target's stopped check follows publication of its mapping.
  preflight_release="$source_release"
fi
if [[ "$source_schema" != "$target_schema" ]]; then
  qualification="/var/lib/jarvis-cutover/held/qualification-$change.json"
  if [[ "$phase" == held ]]; then
    migration snapshot
    if [[ "$rehearsal" != none ]]; then
      if [[ -f "$qualification" ]]; then
        cmp -s "$rehearsal" "$qualification" ||
          refuse "held $change already binds another qualification receipt"
      else
        migration verify-rehearsal "$rehearsal"
        persist "$rehearsal" "$qualification"
      fi
    fi
    [[ -f "$qualification" ]] || refuse "held $change. rehearse the bound stopped copy before continuing"
    migration verify-rehearsal "$qualification"
  fi
  [[ -f "$qualification" ]] || refuse "held $change. bound qualification receipt missing"
  if [[ "$rehearsal" != none ]]; then
    cmp -s "$rehearsal" "$qualification" || refuse "held $change already binds another qualification receipt"
  fi
elif [[ "$phase" == held && "$repair_of" == none ]] &&
    ! check_maintenance "$preflight_release" "$scratch/unchanged-authority.json" "$scratch/source-check.json"; then
  if [[ -s "$scratch/source-check.json" ]]; then cat "$scratch/source-check.json"; fi
  if safe_source_return "$scratch/source-check.json" && check_source_activation "$source_release"; then
    "$custody" not-applied "$change" --evidence "$scratch/source-check.json"
    "$custody" start "$change"
  fi
  refuse "change $change blocked by stopped compatibility checks"
fi
source_native_contract="$(native_contract_of "$source_release")"
target_native_contract="$(native_contract_of "$release")"
if [[ "$source_schema" == "$target_schema" && "$source_native_contract" != "$target_native_contract" ]]; then
  native_inventory="$held/native-inventory-$change.json"
  if [[ "$phase" == held && ! -f "$native_inventory" ]]; then
    deployment_runtime_check "$source_release" 0 "$source_release/.venv/bin/jarvis" cutover-native
    inventory_source="$(deployment_runtime_check "$source_release" 0 "$source_release/.venv/bin/python" -c '
from jarvis.settings import CutoverSettings

print(CutoverSettings.from_env().runtime_state_directory / "one-main-cutover.json")
')"
    persist "$inventory_source" "$native_inventory"
  fi
  [[ -f "$native_inventory" ]] || refuse "held $change. original native inventory is missing"
  if [[ "$phase" == held ]]; then
    deployment_runtime_check "$release" 0 "$release/.venv/bin/python" - <<'PYCODE'
import asyncio

from jarvis.db import create_engine
from jarvis.native_cutover import require_native_data
from jarvis.ownership import deployment_ownership
from jarvis.settings import PausedSettings


async def check():
    settings = PausedSettings.from_env()
    engine = create_engine(settings.database_url.get_secret_value())
    try:
        async with deployment_ownership(engine) as database:
            await require_native_data(database, conversation_id=settings.owner_scope)
    finally:
        await engine.dispose()


asyncio.run(check())
PYCODE
  fi
fi

if [[ "$phase" == held && -f "$scratch/source-check.json" ]]; then
  "$custody" applying "$change" --evidence "$scratch/source-check.json"
else
  "$custody" applying "$change"
fi
if [[ "$source_schema" != "$target_schema" ]]; then migration migrate "$qualification"; fi
"$release/deploy/install-contained-host" --held "$change" "$commit" "$mapping_source"
if [[ "$repair_of" != none ]]; then
  check_maintenance "$release" "$scratch/unchanged-authority.json" "$scratch/repair-check.json"
  "$custody" applying "$change" --evidence "$scratch/repair-check.json"
fi
[[ "$(sha256sum "$mapping" | cut -d' ' -f1)" == "$mapping_digest" ]] ||
  refuse "held $change. target native mapping changed"
[[ "$(check_release_schema "$release")" == "$target_schema" ]] ||
  refuse "held $change. target database schema changed"
check_maintenance "$release" "$scratch/unchanged-authority.json" "$scratch/target-check.json"
if [[ "$source_schema" != "$target_schema" ]]; then migration verify-target "$qualification"; fi
if [[ "$reader" != none ]]; then
  "$release/.venv/bin/python" "$release/deploy/qualified-reader" publish "$release" "$stored_reader" "$backup_facts" >/dev/null
else
  [[ "$(backup_hashes)" == "$(cat "$held/backup-before-$change.sha256")" ]] ||
    refuse "held $change. backup declaration changed"
fi
if [[ -f "$backup_config" ]]; then
  "$release/.venv/bin/python" "$release/deploy/qualified-reader" current "$release" >/dev/null
fi
install_selection
"$custody" commit "$change" --evidence "$scratch/target-check.json"
"$custody" start "$change"
prune_releases
