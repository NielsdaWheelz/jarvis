#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
source_environment="${JARVIS_SOURCE_BACKUP_ENVIRONMENT:-$repo_dir/.secrets/jarvis-backup-r2.env}"
source_password="${JARVIS_SOURCE_RESTIC_PASSWORD:-$repo_dir/.secrets/jarvis-restic-password}"

for path in "$source_environment" "$source_password"; do
  [[ "$path" = /* && -f "$path" && ! -L "$path" ]] || {
    printf 'missing or unsafe private backup source: %s\n' "$path" >&2
    exit 1
  }
done

scratch="$(mktemp -d "${TMPDIR:-/tmp}/jarvis-backup-secrets.XXXXXX")"
cleanup() {
  case "$scratch" in
  "${TMPDIR:-/tmp}"/jarvis-backup-secrets.*) rm -rf -- "$scratch" ;;
  *) return 1 ;;
  esac
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$scratch"
umask 077

python3 - "$source_environment" "$scratch/backup.env" <<'PY'
import pathlib
import re
import sys
from urllib.parse import urlsplit

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
raw = source.read_bytes()
if b"\x00" in raw:
    raise SystemExit("backup environment contains a NUL byte")
text = raw.decode("utf-8")
values = {}
for line in text.splitlines():
    if not line or line.startswith("#"):
        continue
    match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=([^\n]+)", line)
    if match is None or match.group(1) in values:
        raise SystemExit("backup environment has an unsupported line")
    values[match.group(1)] = match.group(2)
required = {"RESTIC_REPOSITORY", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"}
if set(values) != required:
    raise SystemExit("backup environment key roster is incompatible")
repository = values["RESTIC_REPOSITORY"]
if not repository.startswith("s3:https://"):
    raise SystemExit("backup repository is not Cloudflare R2")
parsed = urlsplit(repository[3:])
if (
    parsed.scheme != "https"
    or parsed.hostname is None
    or not parsed.hostname.endswith(".r2.cloudflarestorage.com")
    or len(parsed.path.strip("/").split("/")) < 2
    or parsed.username is not None
    or parsed.password is not None
    or parsed.query
    or parsed.fragment
):
    raise SystemExit("backup repository must name a private bucket and prefix")
static = """\
RESTIC_PASSWORD_FILE=/etc/jarvis/restic-password
RESTIC_CACHE_DIR=/var/lib/jarvis/restic-cache
JARVIS_BACKUP_CONNECTOR_STATE_PATH=/var/lib/jarvis/connectors/google-oauth-state.json
JARVIS_BACKUP_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
JARVIS_BACKUP_STAGING_DIRECTORY=/var/lib/jarvis/backup-staging
JARVIS_RESTORE_STATE_ROOT=/var/lib/jarvis
JARVIS_RESTORE_STAGING_DIRECTORY=/var/lib/jarvis/restore-staging
"""
target.write_bytes(raw.rstrip(b"\n") + b"\n" + static.encode("utf-8"))
target.chmod(0o600)
PY

python3 - "$source_password" "$scratch/restic-password" <<'PY'
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
value = source.read_bytes()
if len(value) < 33 or len(value) > 1025 or b"\x00" in value:
    raise SystemExit("Restic password must be 32-1024 bytes plus a newline")
if value.count(b"\n") != 1 or not value.endswith(b"\n"):
    raise SystemExit("Restic password must contain one newline-terminated value")
target.write_bytes(value)
target.chmod(0o600)
PY

remote="$(ssh "$target" mktemp -d /tmp/jarvis-backup-secrets.XXXXXX)"
case "$remote" in /tmp/jarvis-backup-secrets.*) ;; *) exit 1 ;; esac
scp -q "$scratch/backup.env" "$scratch/restic-password" "$target:$remote/"

ssh "$target" bash -s -- "$remote" <<'REMOTE'
set -euo pipefail
remote="$1"
case "$remote" in /tmp/jarvis-backup-secrets.*) ;; *) exit 1 ;; esac
cleanup() {
  case "$remote" in /tmp/jarvis-backup-secrets.*) rm -rf -- "$remote" ;; *) return 1 ;; esac
}
trap cleanup EXIT HUP INT TERM
for file in backup.env restic-password; do
  [[ -f "$remote/$file" && ! -L "$remote/$file" ]]
done
sudo install -m 0640 -o root -g jarvis "$remote/backup.env" /etc/jarvis/backup.env
sudo install -m 0640 -o root -g jarvis \
  "$remote/restic-password" /etc/jarvis/restic-password
printf 'Installed Jarvis-only R2 and Restic credentials.\n'
REMOTE
