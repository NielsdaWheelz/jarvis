#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
operation=activate
if [[ "${1:-}" == --prepare ]]; then
  operation=prepare
  shift
fi
mail_request=0d3bcc75-749d-4014-a0df-3cdf545366b3
if [[ "${1:-}" == --mail-request ]]; then
  mail_request="${2:?supply the externally selected incident request uuid}"
  shift 2
fi
[[ "$mail_request" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || exit 64
commit="${1:-}"
if [[ ! "$commit" =~ ^[0-9a-f]{40}$ ]] || (($# != 1)); then
  printf 'usage: deploy/activate-release [--prepare] [--mail-request UUID] FULL_GIT_COMMIT\n' >&2
  exit 64
fi
tree="$(git -C "$repo_dir" rev-parse --verify "$commit^{tree}")"
lock_sha="$(git -C "$repo_dir" show "$commit:uv.lock" | shasum -a 256 | awk '{print $1}')"

{
cat "$repo_dir/deploy/release-functions"
cat <<'REMOTE'
set -euo pipefail
commit="$1"
release="/opt/jarvis/releases/$commit"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]

refuse() {
  printf '%s\n' "$1" >&2
  exit 1
}

sudo -n test -f "$release/RELEASE.json" || refuse "release is not installed"
receipt="$(python3 - "$commit" "$2" "$3" "$release/RELEASE.json" <<'PYCODE'
import json, pathlib, sys
expected = dict(zip(("commit", "tree", "uv_lock_sha256"), sys.argv[1:4], strict=True))
if json.loads(pathlib.Path(sys.argv[4]).read_bytes()) != expected:
    raise SystemExit("installed receipt differs from externally selected release")
print(json.dumps(expected, separators=(",", ":")))
PYCODE
)"
operation="$4"
mail_request="$5"
snapshot="/var/lib/jarvis-cutover/adr0086/$commit"
hold=/etc/systemd/system/jarvis-cutover.hold
source=/opt/jarvis/releases/05d1c33b5dc31db96f9aef6318591ded786c3c4f
selected="$(readlink -e /opt/jarvis/current)"
cutover() {
  systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
    "--property=WorkingDirectory=$release" \
    --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
    --property=EnvironmentFile=/etc/jarvis/jarvis.env \
    --property=EnvironmentFile=/etc/jarvis/migration.env \
    "$release/.venv/bin/python" "$release/deploy/prepare-cutover" "$1" "$snapshot" "$receipt" "$mail_request" </dev/null
}
if [[ "$operation" == prepare ]]; then
  [[ "$selected" == "$source" ]] || refuse "cut requires the incident source release"
  "$release/deploy/cutover-hold" stop "$commit"
  if [[ -d "$snapshot" ]]; then cutover verify; else cutover snapshot; fi
  exit
fi
if [[ -e "$hold" ]]; then
  "$release/deploy/cutover-hold" check "$commit"
elif [[ "$selected" == "$source" ]]; then
  refuse "first prepare the stopped incident cut"
else
  [[ "$(systemctl show -p ActiveState --value jarvis.service)" == inactive &&
     "$(systemctl show -p Result --value jarvis.service)" == success &&
     "$(systemctl show -p MainPID --value jarvis.service)" == 0 ]] ||
    refuse "jarvis.service did not stop cleanly"
fi

runtime_properties=(
  --property=Type=oneshot --property=User=jarvis --property=Group=jarvis
  --property=SupplementaryGroups=codex-clients
  --property=ProtectHome=true --property=ProtectSystem=strict
  --property=PrivateTmp=true --property=PrivateDevices=true
  --property=NoNewPrivileges=true
  --property=BindsTo=jarvis-codex-contained.service
  --property=After=jarvis-codex-contained.service
  --property=BindReadOnlyPaths=/run/jarvis-contained/exec/app-server.sock:/run/jarvis-contained/app-server.sock
  "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6"
  "--property=ReadWritePaths=/var/lib/jarvis /run/jarvis-codex-cognition /var/cache/jarvis/attachments"
  "--property=WorkingDirectory=$release"
  --property=EnvironmentFile=/etc/jarvis/database-runtime.env
  --property=EnvironmentFile=/etc/jarvis/jarvis.env
)
sudo -n systemctl is-active --quiet jarvis-codex-contained.service ||
  refuse "the separate native host is not active; leave service stopped"
host_check_unit="jarvis-host-check-${commit:0:12}-$RANDOM"
sudo -n systemd-run --quiet --wait --pipe --collect --unit="$host_check_unit" \
  "${runtime_properties[@]}" \
  --property=Environment=JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json \
  "$release/.venv/bin/python" "$release/deploy/codex-host" verify </dev/null ||
  refuse "the same-release native host did not qualify; leave service stopped"

schema_unit="jarvis-schema-${commit:0:12}-$RANDOM"
schema="$(sudo -n systemd-run --quiet --wait --pipe --collect \
  --unit="$schema_unit" --property=Type=oneshot \
  "--property=WorkingDirectory=$release" \
  --property=EnvironmentFile=/etc/jarvis/migration.env \
  "$release/.venv/bin/python" - <<'PY'
import os

from sqlalchemy import create_engine, text
from sqlalchemy.exc import SQLAlchemyError

from jarvis.db import normalize_database_url
from jarvis.ownership import DEPLOYMENT_LOCK_KEY

try:
    engine = create_engine(normalize_database_url(os.environ["JARVIS_MIGRATION_DATABASE_URL"]))
    with engine.begin() as connection:
        if not connection.scalar(
            text("SELECT pg_try_advisory_xact_lock(:key)"), {"key": DEPLOYMENT_LOCK_KEY}
        ):
            raise SystemExit("schema inspection requires a stopped deployment")
        revision = connection.scalar(text("SELECT version_num FROM alembic_version"))
    engine.dispose()
except (KeyError, SQLAlchemyError, ValueError):
    raise SystemExit("schema inspection failed") from None
print(revision)
PY
)"
check_args=()
if [[ -e "$hold" ]]; then
  if [[ "$schema" == 0013 ]]; then cutover migrate; fi
  cutover verify-target
  check_args+=(--fit-pending-mail "$mail_request")
elif [[ "$schema" != 0015 ]]; then
  refuse "routine activation requires current schema 0015"
fi

check_unit="jarvis-check-${commit:0:12}-$RANDOM"
if [[ -e "$hold" ]]; then
  # Retain each stopped fit/action report, including refusals on repeated checks.
  preflight="$(mktemp "$snapshot/activation-XXXXXXXX.log")"
else
  preflight=/dev/null
fi
sudo -n systemd-run --quiet --wait --pipe --collect --unit="$check_unit" \
  "${runtime_properties[@]}" "$release/.venv/bin/jarvis" check-activation "${check_args[@]}" </dev/null 2>&1 | tee "$preflight" ||
  refuse "activation check failed; leave service stopped"

started=0
stop_failed_activation() {
  status=$?
  if ((status != 0 && started)); then
    sudo -n systemctl stop jarvis.service || true
  fi
  exit "$status"
}
trap stop_failed_activation EXIT
sudo -n install -m 0644 -o root -g root \
  "$release/deploy/jarvis.service" /etc/systemd/system/jarvis.service
sudo -n systemctl daemon-reload
temporary="/opt/jarvis/.current-$commit"
sudo -n rm -f -- "$temporary"
sudo -n ln -s "releases/$commit" "$temporary"
sudo -n mv -Tf "$temporary" /opt/jarvis/current
if [[ -e "$hold" ]]; then "$release/deploy/cutover-hold" release "$commit"; fi
started=1
sudo -n systemctl enable --now jarvis.service
sleep 10
[[ "$(sudo -n systemctl show --property=ActiveState --value jarvis.service)" == active ]] ||
  refuse "the selected service did not stay active; leave it stopped"
[[ "$(sudo -n systemctl show --property=SubState --value jarvis.service)" == running ]] ||
  refuse "the selected service is not running; leave it stopped"
[[ "$(sudo -n systemctl show --property=NRestarts --value jarvis.service)" == 0 ]] ||
  refuse "the selected service restarted during activation; leave it stopped"
main_pid="$(sudo -n systemctl show --property=MainPID --value jarvis.service)"
[[ "$main_pid" =~ ^[1-9][0-9]*$ ]] ||
  refuse "the selected service has no live process; leave it stopped"
prune_releases
printf 'activated jarvis release: %s\n' "$commit"
printf 'canonical control is unchanged; new reasoning waits for validated discord catch-up\n'
REMOTE
} | ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy \
  sudo -n flock /opt/jarvis/.deploy.lock bash -s -- "$commit" "$tree" "$lock_sha" "$operation" "$mail_request"
