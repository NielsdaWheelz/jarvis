#!/usr/bin/env python3
"""Bind one stopped release transition to its database and private recovery copy."""

import argparse
import asyncio
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

from alembic import command
from alembic.config import Config
from sqlalchemy import text
from sqlalchemy.engine import make_url

from jarvis._atomic_json import replace_private_json
from jarvis.db import APPLICATION_SCHEMA_REVISION, create_engine, normalize_database_url
from jarvis.ownership import maintenance_ownership

SOURCE = "0015"
TARGET = "0016"
ROOT = Path("/opt/jarvis")
STATE = Path("/var/lib/jarvis")
DECLARATIONS = Path("/etc/jarvis")
KEYS = {
    "message": "id",
    "action": "id",
    "model_decision": "decision_id",
    "read_position": "position",
    "native_attempt": "conversation_id, attempt_seq",
    "native_invocation": "id",
    "native_input_delivery": "attempt_id, message_id",
    "work": "id",
    "attachment": "id",
    "event_cursor": "kind, account_id, resource_id",
    "memory_log": "id",
    "memory_summary": "id",
    "source_record": "id",
    "source_conversation": "id",
    "memory_lane": "machine, account",
    "memory_leaf": "position",
    "memory_node": "level, node_index",
    "memory_state": "id",
}


def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def file_digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def copy_digest(root):
    digest = hashlib.sha256()
    for path in [root, *sorted(root.rglob("*"))]:
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            content = os.readlink(path)
        elif stat.S_ISREG(info.st_mode):
            content = file_digest(path)
        elif stat.S_ISDIR(info.st_mode):
            content = None
        else:
            raise RuntimeError("unsupported recovery file type")
        entry = [
            str(path.relative_to(root)),
            info.st_mode,
            info.st_uid,
            info.st_gid,
            content,
        ]
        digest.update(json.dumps(entry, ensure_ascii=True).encode() + b"\n")
    return digest.hexdigest()


async def inventory(conn, channel):
    # Hash original database projections on the server. json (including escaped
    # NUL) and ordered keys survive. Only fixed-size hashes cross the connection.
    await conn.execute(text("SET LOCAL TIME ZONE 'UTC'"))
    facts = {}
    for table, keys in KEYS.items():
        columns = list(
            (
                await conn.execute(
                    text("""
            SELECT column_name FROM information_schema.columns
            WHERE table_schema='public' AND table_name=:table
            ORDER BY ordinal_position
        """),
                    {"table": table},
                )
            ).scalars()
        )
        cols = ", ".join('"' + c.replace('"', '""') + '"' for c in columns)
        require(cols, "missing application table")
        query = f"""SELECT sha256(convert_to(row_to_json(original)::text, 'UTF8'))
                    FROM (SELECT {cols} FROM public.{table}) original ORDER BY {keys}"""
        digest, count = hashlib.sha256(), 0
        async for row in (await conn.stream(text(query))).scalars():
            digest.update(row)
            count += 1
        facts[table] = [count, digest.hexdigest()]
    control = (
        await conn.execute(
            text("""
        SELECT id::text,control_kind,control_sequence FROM message
        WHERE source_conversation_id=:channel AND control_kind IS NOT NULL
        ORDER BY control_sequence DESC LIMIT 1
    """),
            {"channel": channel},
        )
    ).one_or_none()
    require(control is not None, "canonical control is uninitialized")
    return {"tables": facts, "last_control": list(control)}


def write_snapshot(destination, evidence, system_stop, args, sql_snapshot):
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    require(not destination.exists(), "snapshot exists; verify it or inspect it")
    stage = Path(tempfile.mkdtemp(prefix=".incomplete-", dir=destination.parent))
    try:
        dump = stage / "database.dump"
        with dump.open("xb") as out:
            subprocess.run(
                ["pg_dump", "-Fc", "--snapshot", sql_snapshot], stdout=out, **args
            )
        subprocess.run(["pg_restore", "--file=/dev/null", str(dump)], **args)
        copies = {}
        for name, path in (
            ("private-state", STATE),
            ("declarations", DECLARATIONS),
        ):
            subprocess.run(["cp", "-a", "--", str(path), str(stage / name)], check=True)
            copies[name] = copy_digest(stage / name)
            require(copies[name] == copy_digest(path), "private copy mismatch")
        replace_private_json(
            stage / "SNAPSHOT.json",
            {
                **evidence,
                "copies": copies,
                "dump_sha256": file_digest(dump),
                "system_stop": system_stop,
            },
        )
        os.sync()
        stage.rename(destination)
        os.sync()
    finally:
        if stage.exists():
            shutil.rmtree(stage)


async def cut(operation, destination, source, target, system_stop):
    runtime = make_url(normalize_database_url(os.environ["JARVIS_DATABASE_URL"]))
    migration_url = normalize_database_url(os.environ["JARVIS_MIGRATION_DATABASE_URL"])
    migrator = make_url(migration_url)
    endpoint = [runtime.host, runtime.port or 5432, runtime.database]
    require(
        endpoint == [migrator.host, migrator.port or 5432, migrator.database]
        and migrator.host
        and migrator.database
        and not (set(migrator.query) - {"sslmode"}),
        "migration and runtime database endpoints differ or are unsupported",
    )
    channel = os.environ["JARVIS_DISCORD_CHANNEL_ID"]
    require(channel.isdecimal() and int(channel) > 0, "invalid channel")
    require(
        APPLICATION_SCHEMA_REVISION == TARGET and destination.name == target["commit"],
        "target release or schema mismatch",
    )
    source_file = ROOT / "releases" / source["commit"] / "RELEASE.json"
    require(
        json.loads(source_file.read_bytes()) == source,
        "source release receipt mismatch",
    )
    selected = (ROOT / "current").resolve(strict=True)
    allowed = [source_file.parent]
    if operation in {"verify-target", "commit-settings"}:
        allowed.append(ROOT / "releases" / target["commit"])
    require(selected in allowed, "selected source changed")
    target_dir = ROOT / "releases" / target["commit"]
    require(
        json.loads((target_dir / "RELEASE.json").read_bytes()) == target
        and Path(__file__).resolve().parent.parent == target_dir,
        "wrong target receipt",
    )
    args = dict(
        env={
            "PATH": os.defpath,
            "PGHOST": migrator.host,
            "PGPORT": str(migrator.port or 5432),
            "PGDATABASE": migrator.database,
            "PGUSER": migrator.username or "",
            "PGPASSWORD": migrator.password or "",
            **(
                {"PGSSLMODE": migrator.query["sslmode"]}
                if "sslmode" in migrator.query
                else {}
            ),
        },
        check=True,
        stderr=subprocess.DEVNULL,
    )
    engine = create_engine(migration_url)
    try:
        async with maintenance_ownership(engine) as db, db.begin() as conn:
            if operation == "snapshot":
                await conn.execute(
                    text("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ")
                )
            version = await conn.scalar(text("SELECT version_num FROM alembic_version"))
            require(
                version
                == (
                    TARGET
                    if operation in {"verify-target", "commit-settings"}
                    else SOURCE
                ),
                "unexpected stopped schema",
            )
            evidence = {
                "format": "jarvis-stopped-cut.v2",
                "source": source,
                "target": target,
                "channel": channel,
                "database": endpoint,
                "schemas": [SOURCE, TARGET],
                "facts": await inventory(conn, channel),
            }
            require(
                evidence["facts"]["last_control"][1] == "pause",
                "memory service cut requires an ordinary recorded owner pause",
            )
            if operation == "snapshot":
                sql_snapshot = await conn.scalar(text("SELECT pg_export_snapshot()"))
                write_snapshot(destination, evidence, system_stop, args, sql_snapshot)
                return
            manifest = json.loads((destination / "SNAPSHOT.json").read_bytes())
            require(
                all(manifest.get(k) == v for k, v in evidence.items()),
                "stopped facts or release receipts changed",
            )
            require(
                file_digest(destination / "database.dump") == manifest["dump_sha256"]
                and all(
                    copy_digest(destination / k) == manifest["copies"][k]
                    for k in ("private-state", "declarations")
                ),
                "damaged recovery copy",
            )
            if operation == "provision":
                from memory_credentials import provision_memory

                provision_memory()
            if operation == "commit-settings":
                from memory_credentials import activate_memory

                activate_memory()
            if operation == "migrate":
                # Alembic uses this exact connection and transaction. There is
                # no unlock between the final comparison and the schema change.
                def upgrade(connection):
                    config = Config(str(target_dir / "alembic.ini"))
                    config.attributes["connection"] = connection
                    command.upgrade(config, TARGET)

                await conn.run_sync(upgrade)
            if operation in {"migrate", "verify-target"}:
                require(
                    await conn.scalar(text("SELECT version_num FROM alembic_version"))
                    == TARGET,
                    "migration did not reach target",
                )
    finally:
        await engine.dispose()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "operation",
        choices=[
            "snapshot",
            "verify",
            "provision",
            "migrate",
            "verify-target",
            "commit-settings",
        ],
    )
    parser.add_argument("destination", type=Path)
    parser.add_argument("source_receipt", type=json.loads)
    parser.add_argument("target_receipt", type=json.loads)
    args = parser.parse_args()
    stop = json.loads(
        subprocess.check_output(
            [
                Path(__file__).with_name("cutover-hold"),
                "check",
                args.target_receipt["commit"],
            ]
        )
    )
    os.umask(0o077)
    asyncio.run(
        cut(
            args.operation,
            args.destination,
            args.source_receipt,
            args.target_receipt,
            stop,
        )
    )
    print("stopped cut validated:", args.operation)


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(
            str(error) if type(error) is RuntimeError else type(error).__name__,
            file=sys.stderr,
        )
        sys.exit(1)
