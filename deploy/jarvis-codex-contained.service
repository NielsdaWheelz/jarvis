[Unit]
Description=Jarvis @ACCOUNT@ Codex host
After=network-online.target
Wants=network-online.target
@COUPLING@
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=exec
User=@HOST_USER@
Group=codex-clients
WorkingDirectory=/
@CREDENTIAL@
Environment=JARVIS_CODEX_HOST_CONFIG_PATH=@SOCKET_ROOT@/codex-host.json
ExecStart=@RELEASE@/.venv/bin/python @RELEASE@/deploy/codex-host start @ACCOUNT@
ExecStartPost=@RELEASE@/.venv/bin/python @RELEASE@/deploy/codex-host publish @ACCOUNT@
ExecStopPost=@RELEASE@/.venv/bin/python @RELEASE@/deploy/codex-host cleanup @ACCOUNT@
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10
KillMode=control-group
UMask=0077
RuntimeDirectory=@SOCKET_DIRECTORY@ @SOCKET_DIRECTORY@/exec
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=restart
BindPaths=@SOCKET_ROOT@/exec:/tmp
BindReadOnlyPaths=/etc/jarvis/codex-host.json:@SOCKET_ROOT@/codex-host.json
BindReadOnlyPaths=/var/cache/jarvis/attachments
InaccessiblePaths=@INACCESSIBLE@
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelModules=true
@KERNEL_PROTECTION@
ProtectProc=ptraceable
ReadWritePaths=@SOCKET_ROOT@ @ACCOUNT_HOME@ /var/lib/jarvis-notes
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6@EXTRA_ADDRESS_FAMILY@
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TasksMax=256
LimitCORE=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
