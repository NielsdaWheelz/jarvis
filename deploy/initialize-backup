#!/usr/bin/env bash
set -euo pipefail

target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
commit="${1:-}"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'usage: deploy/initialize-backup FULL_GIT_COMMIT\n' >&2
  exit 64
}

ssh "$target" bash -s -- "$commit" <<'REMOTE'
set -euo pipefail
commit="$1"
release="/opt/jarvis/releases/$commit"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
sudo test -f "$release/RELEASE.json"
for file in /etc/jarvis/backup-database.env /etc/jarvis/backup.env \
  /etc/jarvis/restic-password; do
  sudo test -f "$file"
  sudo test ! -L "$file"
done

sudo -u jarvis bash -c '
  set -euo pipefail
  set -a
  source /etc/jarvis/backup-database.env
  source /etc/jarvis/backup.env
  set +a
  "$1/.venv/bin/python" - <<"PY"
from jarvis.backup import BackupEnvironment

BackupEnvironment.from_env()
PY
  if /usr/bin/restic snapshots --latest 1 >/dev/null 2>&1; then
    printf "Restic repository is already initialized.\n"
  else
    /usr/bin/restic init --repository-version 2
    /usr/bin/restic snapshots --latest 1 >/dev/null
    printf "Initialized and reopened Restic repository version 2.\n"
  fi
' bash "$release"
REMOTE
