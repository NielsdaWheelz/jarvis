JARVIS_DATABASE_URL=postgresql://jarvis_runtime:jarvis-runtime-dev@127.0.0.1:54328/jarvis
JARVIS_DISCORD_BOT_TOKEN=replace-with-private-service-secret
JARVIS_DISCORD_OWNER_USER_ID=100000000000000001
JARVIS_DISCORD_GUILD_ID=100000000000000002
JARVIS_DISCORD_CHANNEL_ID=100000000000000003
JARVIS_DISCORD_CATCH_UP_LIMIT=100
JARVIS_DISCORD_REQUEST_TIMEOUT_SECONDS=10
JARVIS_DISCORD_DELIVERY_RETRY_DELAYS_SECONDS=0.5,2.0
JARVIS_OWNER_TIMEZONE=America/Los_Angeles
JARVIS_CODEX_PROFILE_KEY=personal
JARVIS_CODEX_MODEL=gpt-5.6-terra
JARVIS_CODEX_HOST_CONFIG_PATH=/etc/codex-shared/profiles.json
JARVIS_HERDR_SSH_CONFIG_PATH=/etc/jarvis-herdr/ssh_config
# ssh config label=the owner's home on that host; the gate's account homes live there.
JARVIS_HERDR_MACHINES=devbox=/home/niels,macbook=/Users/nnandal,arch=/home/nnandal
JARVIS_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
JARVIS_GOOGLE_OAUTH_STATE_PATH=/var/lib/jarvis/secrets/google-oauth-state.json
JARVIS_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
JARVIS_GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
# Comma-separated IDs whose live ACL was verified owner-only by the operator.
JARVIS_VERIFIED_OWNER_ONLY_CALENDAR_IDS=primary
JARVIS_CONNECTOR_ENCRYPTION_KEY_VERSION=v2
JARVIS_CONNECTOR_ENCRYPTION_SECRET=replace-with-qualified-base64url-secret
JARVIS_MAPS_API_KEY=replace-with-maps-api-key
JARVIS_BRAVE_API_KEY=replace-with-brave-api-key
# Dedicated OpenAI project key restricted to the embeddings endpoint.
JARVIS_EMBEDDING_OPENAI_API_KEY=replace-with-embedding-only-openai-project-key
JARVIS_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_EMBEDDING_DIMENSION=1536
JARVIS_DREAM_INTERVAL_SECONDS=86400
JARVIS_MAXIMUM_BATCH_SIZE=20
JARVIS_DELIVERY_BATCH_SIZE=20
