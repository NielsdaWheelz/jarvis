#!/usr/bin/env python3
"""Systemd entry points for the separate contained Codex hosts."""

from __future__ import annotations

import asyncio
import grp
import json
import os
import pwd
import re
import stat
import subprocess
import sys
from pathlib import Path

import httpx
from provider_runtime.agent_runtime import (
    CODEX_CONTAINMENT_VERSION,
    CodexUnixEndpoint,
    materialize_codex_containment_catalog,
    qualify_codex_containment_host,
)

from jarvis.codex_config import (
    NEON_ADAPTER_USER,
    NEON_CONTROL_SOCKET,
    CodexAccount,
    CodexHostConfig,
    NeonHost,
)

type StockHost = CodexAccount | NeonHost


def host_home(host: StockHost) -> str:
    return host.account_home if isinstance(host, CodexAccount) else host.host_home


def _host_identity(config: CodexHostConfig, account: StockHost) -> None:
    if (
        os.geteuid() != pwd.getpwnam(account.host_user).pw_uid
        or os.getegid() != grp.getgrnam(config.client_group).gr_gid
    ):
        raise RuntimeError("contained host must use its configured host identity/group")


def host_environment(account: StockHost) -> dict[str, str]:
    return {
        "CODEX_HOME": host_home(account),
        "HOME": pwd.getpwuid(os.geteuid()).pw_dir,
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }


def bootstrap_notes(config: CodexHostConfig, account: CodexAccount) -> None:
    _host_identity(config, account)
    environment = host_environment(account)

    def run(*arguments: str) -> str:
        try:
            return subprocess.run(
                arguments,
                env=environment,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=60,
            ).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            raise RuntimeError(
                "notes bootstrap failed; repair host git/private authentication"
            ) from None

    repository = Path(config.notes_repository)
    if repository.is_symlink():
        raise RuntimeError("notes repository must be an ordinary directory")
    existing = (repository / ".git").is_dir()
    if repository.exists() and not existing and any(repository.iterdir()):
        raise RuntimeError(
            "notes repository contains files without an ordinary checkout"
        )
    subprocess.run(
        [
            config.binary,
            "sandbox",
            "-c",
            'sandbox_mode="workspace-write"',
            "-c",
            "sandbox_workspace_write.network_access=true",
            "--",
            "/bin/true",
        ],
        cwd=repository,
        env=environment,
        check=True,
        timeout=10,
    )
    if existing:
        config.verify_notes_repository()
        if (
            Path(run("git", "-C", str(repository), "rev-parse", "--show-toplevel"))
            != repository
        ):
            raise RuntimeError("notes repository is not its git checkout root")
        origins = {
            "git@github.com:NielsdaWheelz/jarvis-notes.git",
            "git@github.com:NielsdaWheelz/jarvis-notes",
            "ssh://git@github.com/NielsdaWheelz/jarvis-notes.git",
            "ssh://git@github.com/NielsdaWheelz/jarvis-notes",
            "https://github.com/NielsdaWheelz/jarvis-notes.git",
            "https://github.com/NielsdaWheelz/jarvis-notes",
        }
        for direction in ((), ("--push",)):
            origin = run(
                "git",
                "-C",
                str(repository),
                "remote",
                "get-url",
                *direction,
                "--all",
                "origin",
            )
            if origin not in origins:
                raise RuntimeError(
                    "notes origin must select NielsdaWheelz/jarvis-notes"
                )
    if existing:
        run(
            "git",
            "-C",
            str(repository),
            "ls-remote",
            "--exit-code",
            "origin",
            "refs/heads/main",
        )
    else:
        origin = "git@github.com:NielsdaWheelz/jarvis-notes.git"
        run("git", "ls-remote", "--exit-code", origin, "refs/heads/main")
    # Authenticated git just proved existence/access. Anonymous 404 now proves
    # the exact selected repository is not publicly exposed; other results fail.
    try:
        with httpx.Client(trust_env=False, follow_redirects=False, timeout=15) as http:
            visibility = http.get(
                "https://api.github.com/repos/NielsdaWheelz/jarvis-notes"
            )
    except httpx.HTTPError:
        raise RuntimeError(
            "notes privacy check unavailable; repair before bootstrap"
        ) from None
    if visibility.status_code != 404:
        raise RuntimeError(
            "notes origin privacy is not established; repair before bootstrap"
        )
    if not existing:
        run("git", "clone", "--branch", "main", origin, str(repository))
        # Only this new metadata directory needs client traversal/read. Never
        # change existing checkout permissions or make its files group-writable.
        (repository / ".git").chmod(0o750)
    config.verify_notes_repository()


def private_alias(account: StockHost) -> Path:
    return account.socket.parent / "exec" / "app-server.sock"


def remove_alias(config: CodexHostConfig, account: StockHost) -> None:
    _host_identity(config, account)
    public = account.socket
    for path in (private_alias(account), public):
        try:
            metadata = path.lstat()
        except FileNotFoundError:
            continue
        if path == public:
            valid = (
                stat.S_ISREG(metadata.st_mode)
                and stat.S_IMODE(metadata.st_mode) == 0
                and metadata.st_nlink == 1
                and metadata.st_size == 0
            )
        else:
            valid = stat.S_ISLNK(metadata.st_mode)
        if (
            metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or not valid
        ):
            raise RuntimeError(
                "native host cleanup requires its owned alias/placeholder"
            )
        path.unlink()


def start(config: CodexHostConfig, account: StockHost) -> None:
    _host_identity(config, account)
    public = account.socket
    directory = public.parent
    metadata = directory.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) != 0o710
    ):
        raise RuntimeError(
            "contained host socket directory has the wrong ownership/mode"
        )
    alias = private_alias(account)
    execution = alias.parent
    metadata = execution.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) not in (0o700, 0o710)
    ):
        raise RuntimeError("native exec directory has the wrong ownership/mode")
    execution.chmod(0o700)
    remove_alias(config, account)
    os.close(os.open(public, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0))
    environment = host_environment(account)
    overrides: list[str] = []
    if isinstance(account, NeonHost):
        from provider_runtime.agent_runtime.neon_config import (
            NEON_STOCK_BEARER_ENV,
            materialize_neon_catalog,
            neon_stock_overrides,
        )

        catalog = materialize_neon_catalog(directory)
        for setting in neon_stock_overrides(account.adapter_origin):
            overrides.extend(("-c", setting))
        key_path = Path(os.environ["CREDENTIALS_DIRECTORY"]) / "neon-stock-bearer"
        # Exercise the exact installed Linux sandbox before giving stock its bearer.
        subprocess.run(
            [
                config.binary,
                "sandbox",
                "-c",
                'sandbox_mode="workspace-write"',
                "-c",
                "sandbox_workspace_write.network_access=true",
                "--",
                sys.executable,
                "-c",
                (
                    "import os,sys; "
                    "fresh = os.path.samefile('/proc/1/ns/pid', '/proc/self/ns/pid'); "
                    "raise SystemExit(not fresh or os.access(sys.argv[1], os.R_OK))"
                ),
                str(key_path),
            ],
            cwd=config.notes_repository,
            env=environment,
            check=True,
            timeout=10,
        )
        token = key_path.read_text(encoding="ascii").strip()
        if not re.fullmatch(r"[a-f0-9]{64}", token):
            raise RuntimeError("invalid stock adapter credential")
        environment[NEON_STOCK_BEARER_ENV] = f"Bearer {token}"
    else:
        catalog = materialize_codex_containment_catalog(directory)
    version = subprocess.run(
        [config.binary, "--version"],
        env=environment,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=5,
    ).stdout.strip()
    if version != f"codex-cli {CODEX_CONTAINMENT_VERSION}":
        raise RuntimeError(
            "contained host binary differs from the qualified native version"
        )
    # Stock locates its tool host beside the physical executable.
    subprocess.run(
        [Path(config.binary).resolve().with_name("codex-code-mode-host"), "--help"],
        env=environment,
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    os.execve(
        config.binary,
        [
            config.binary,
            "-c",
            f"model_catalog_json={json.dumps(str(catalog))}",
            "-c",
            'service_tier="default"',
            *overrides,
            "app-server",
            "--listen",
            f"unix://{alias}",
            "--strict-config",
        ],
        environment,
    )


async def publish(config: CodexHostConfig, account: StockHost) -> None:
    _host_identity(config, account)
    public = account.socket
    alias = private_alias(account)
    execution = alias.parent
    async with asyncio.timeout(15):
        for _ in range(300):
            if alias.is_symlink() and alias.resolve().is_socket():
                break
            await asyncio.sleep(0.05)
        else:
            raise TimeoutError("contained host native socket did not become ready")
        target = alias.resolve()
        metadata = target.stat()
        child = execution / f"codex-daemon-{os.geteuid()}"
        parent = child.lstat()
        placeholder = public.lstat()
        if (
            not target.parent.samefile(child)
            or not stat.S_ISDIR(parent.st_mode)
            or parent.st_uid != os.geteuid()
            or parent.st_gid != os.getegid()
            or stat.S_IMODE(parent.st_mode) != 0o700
            or not stat.S_ISSOCK(metadata.st_mode)
            or metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or metadata.st_nlink != 1
            or stat.S_IMODE(execution.stat().st_mode) != 0o700
            or stat.S_IMODE(public.parent.stat().st_mode) != 0o710
            or not stat.S_ISREG(placeholder.st_mode)
            or stat.S_IMODE(placeholder.st_mode) != 0
            or placeholder.st_uid != os.geteuid()
            or placeholder.st_gid != os.getegid()
            or placeholder.st_nlink != 1
            or placeholder.st_size != 0
        ):
            raise RuntimeError("native socket must stay in its private stock directory")
        endpoint = CodexUnixEndpoint(target)
        if isinstance(account, NeonHost):
            from provider_runtime.agent_runtime.neon_config import qualify_neon_host

            await qualify_neon_host(endpoint, origin=account.adapter_origin)
        else:
            await qualify_codex_containment_host(
                endpoint, required_service_tier="default"
            )
        current = target.stat()
        if (current.st_dev, current.st_ino) != (metadata.st_dev, metadata.st_ino):
            raise RuntimeError("native socket changed during qualification")
        target.chmod(0o660)
        alias.unlink()
        alias.symlink_to(Path(child.name) / target.name)


async def verify(config: CodexHostConfig, account: StockHost) -> None:
    config.verify_notes_repository()
    alias = account.socket
    directory = alias.parent
    host_uid = pwd.getpwnam(account.host_user).pw_uid
    client_gid = grp.getgrnam(config.client_group).gr_gid
    metadata = alias.lstat()
    parent = directory.stat()
    if (
        not stat.S_ISSOCK(metadata.st_mode)
        or metadata.st_uid != host_uid
        or metadata.st_gid != client_gid
        or stat.S_IMODE(metadata.st_mode) != 0o660
        or metadata.st_nlink != 1
        or parent.st_uid != host_uid
        or parent.st_gid != client_gid
        or stat.S_IMODE(parent.st_mode) != 0o710
    ):
        raise RuntimeError(
            "contained host socket is not published to the configured group"
        )
    if os.access(Path(host_home(account)) / "auth.json", os.R_OK):
        raise RuntimeError(
            "application needs socket access without account credentials"
        )
    endpoint = CodexUnixEndpoint(alias)
    if isinstance(account, NeonHost):
        from provider_runtime.agent_runtime.neon_config import qualify_neon_host

        await qualify_neon_host(endpoint, origin=account.adapter_origin)
        print("google_neon: contained host, standard tier; billing unchecked")
        return
    await qualify_codex_containment_host(endpoint, required_service_tier="default")
    from provider_runtime.agent_runtime import CodexControl, CodexSubject

    # This runs as Jarvis through the same application-private mount. A
    # structurally valid endpoint is insufficient without its enrolled subject.
    control = CodexControl({account.key: endpoint}, lambda _: False, native_owners=True)
    try:
        async with asyncio.timeout(10):
            allowance = await control.observe_codex_allowance(
                account.key,
                CodexSubject(
                    account.expected_user_id,
                    account.expected_account_id,
                    account.expected_plan_type,
                ),
                allow_existing_credits=account.allow_existing_credits,
            )
    finally:
        await control.close()
    if allowance.state not in {
        "available",
        "available_with_credits",
        "credits_available",
        "included_exhausted",
    }:
        raise RuntimeError(f"{account.key}: account allowance is unverified")
    print(f"{account.key}: qualified contained host, standard tier, {allowance.state}")


def verify_release(route: str) -> None:
    unit_path = stock_unit(route).replace("-", "_2d").replace(".", "_2e")
    release = Path(__file__).resolve().parent.parent
    response = subprocess.run(
        [
            "busctl",
            "--json=short",
            "get-property",
            "org.freedesktop.systemd1",
            f"/org/freedesktop/systemd1/unit/{unit_path}",
            "org.freedesktop.systemd1.Service",
            "ExecStart",
        ],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=5,
    )
    value = json.loads(response.stdout)
    if value.get("type") != "a(sasbttttuii)":
        raise RuntimeError("systemd returned an unsupported ExecStart property")
    data = value["data"]
    executable = str(release / ".venv/bin/python")
    argv = [executable, str(release / "deploy/codex-host"), "start", route]
    if len(data) != 1 or data[0][:2] != [executable, argv]:
        raise RuntimeError("contained host unit does not select this immutable release")


def verify_notes_acl(config: CodexHostConfig) -> None:
    config.verify_notes_repository()
    notes = Path(config.notes_repository)
    required = {
        "user::rwx",
        "mask::rwx",
        "other::---",
        f"user:{pwd.getpwnam(config.jarvis_user).pw_uid}:r-x",
        *(
            f"user:{pwd.getpwnam(host.host_user).pw_uid}:rwx"
            for host in (config.personal, config.google_neon)
        ),
    }
    for path, directories, _ in notes.walk():
        if path == notes / ".git/jarvis-mail" and "incoming" in directories:
            directories.remove("incoming")
        result = subprocess.run(
            [
                "getfacl",
                "--default",
                "--numeric",
                "--omit-header",
                "--no-effective",
                "--",
                path,
            ],
            check=True,
            capture_output=True,
            text=True,
        )
        entries = set(result.stdout.splitlines())
        if not required.issubset(entries) or not entries.intersection(
            {"group::r-x", "group::r--", "group::--x", "group::---"}
        ):
            raise RuntimeError(
                "a shared notes directory lacks the inherited account ACL"
            )


def render_units(config: CodexHostConfig, mapping: Path, output: Path) -> None:
    release = Path(__file__).resolve().parent.parent
    primary = config.personal
    expected_sockets = (
        Path("/run/jarvis-contained/app-server.sock"),
        Path("/run/jarvis-contained-neon/app-server.sock"),
    )
    if (
        config.jarvis_user != "jarvis"
        or config.client_group != "codex-clients"
        or primary.host_user != config.development_user
        or (primary.socket, config.google_neon.socket) != expected_sockets
        or config.cognition_cwd_parent != "/run/jarvis-codex-cognition"
        or config.notes_repository != "/var/lib/jarvis-notes"
    ):
        raise RuntimeError("contained hosts require the fixed deployment layout")
    uids = {pwd.getpwnam(config.jarvis_user).pw_uid, 0}
    hosts = (("personal", primary), ("google_neon", config.google_neon))
    for key, account in hosts:
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", account.host_user):
            raise RuntimeError(f"{key}: invalid host user")
        uid = pwd.getpwnam(account.host_user).pw_uid
        if uid in uids:
            raise RuntimeError("services require distinct non-root UIDs")
        uids.add(uid)
        home = Path(host_home(account))
        metadata = home.lstat()
        if (
            home.resolve(strict=True) != home
            or not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != uid
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise RuntimeError(f"{key}: host home must be private and host-owned")
        auth_path = home / "auth.json"
        if isinstance(account, NeonHost):
            if auth_path.exists() or auth_path.is_symlink():
                raise RuntimeError("paid host cannot contain subscription login state")
        else:
            auth = auth_path.lstat()
            if (
                not stat.S_ISREG(auth.st_mode)
                or auth.st_uid != uid
                or stat.S_IMODE(auth.st_mode) != 0o600
            ):
                raise RuntimeError("personal Codex enrollment must be private")
    notes = Path(config.notes_repository)
    if notes.exists() or notes.is_symlink():
        metadata = notes.lstat()
        if (
            not stat.S_ISDIR(metadata.st_mode)
            or metadata.st_uid != pwd.getpwnam(primary.host_user).pw_uid
            or metadata.st_gid != grp.getgrnam(config.client_group).gr_gid
            or metadata.st_mode & 0o007
        ):
            raise RuntimeError("notes checkout requires its existing owner and group")

    template = (release / "deploy/jarvis-codex-contained.service").read_text()

    def quote(value: str | Path) -> str:
        return json.dumps(str(value).replace("%", "%%"), ensure_ascii=False)

    for key, account in hosts:
        directory = account.socket.parent
        home = host_home(account)
        other_home = (
            config.google_neon.host_home if account is primary else primary.account_home
        )
        inaccessible = [
            quote(f"-{home}/{name}") for name in ("AGENTS.override.md", "AGENTS.md")
        ]
        inaccessible.extend(
            (quote(f"-{other_home}"), quote(f"-{NEON_CONTROL_SOCKET.parent}"))
        )
        paid_dependency = (
            "Requires=jarvis-neon-adapter.service\nAfter=jarvis-neon-adapter.service\n"
            "ConditionPathExists=!/var/lib/jarvis-cutover/held/"
            "jarvis-codex-contained.service"
            if isinstance(account, NeonHost)
            else ""
        )
        credential = ""
        if isinstance(account, NeonHost):
            credential = (
                "LoadCredential=neon-stock-bearer:/etc/jarvis/credentials/neon-stock-bearer\n"
                "BindReadOnlyPaths=/etc/jarvis/codex-neon-requirements.toml:"
                "/etc/codex/requirements.toml"
            )
            deny = (
                f"/run/credentials/{stock_unit(key)}",
                str(directory),
                str(NEON_CONTROL_SOCKET.parent),
                f"/tmp/codex-daemon-{pwd.getpwnam(account.host_user).pw_uid}",
            )
            (output / "codex-neon-requirements.toml").write_text(
                'allowed_sandbox_modes = ["read-only", "workspace-write"]\n'
                "[permissions.filesystem]\n"
                f"deny_read = {json.dumps(deny)}\n"
            )
        unit = template
        for marker, value in {
            "@ACCOUNT@": key,
            "@HOST_USER@": account.host_user,
            "@RELEASE@": str(release),
            "@ACCOUNT_HOME@": quote(home),
            "@INACCESSIBLE@": " ".join(inaccessible),
            "@COUPLING@": paid_dependency,
            "@CREDENTIAL@": credential,
            "@SOCKET_ROOT@": str(directory),
            "@SOCKET_DIRECTORY@": directory.name,
        }.items():
            unit = unit.replace(marker, value)
        (output / stock_unit(key)).write_text(unit)
        if account == primary:
            bootstrap = unit
            for source, replacement in (
                ("Type=exec\n", "Type=oneshot\n"),
                ("Restart=on-failure\n", "Restart=no\n"),
                ("TimeoutStartSec=20\n", "TimeoutStartSec=180\n"),
                (
                    "deploy/codex-host start personal\n",
                    "deploy/codex-host bootstrap-notes personal\n",
                ),
                (
                    "BindReadOnlyPaths=/etc/jarvis/codex-host.json:",
                    f"BindReadOnlyPaths={mapping}:",
                ),
            ):
                if bootstrap.count(source) != 1:
                    raise RuntimeError("notes bootstrap template mismatch")
                bootstrap = bootstrap.replace(source, replacement)
            bootstrap = (
                "\n".join(
                    line
                    for line in bootstrap.splitlines()
                    if not line.startswith(("ExecStartPost=", "ExecStopPost="))
                )
                + "\n"
            )
            (output / "jarvis-notes-bootstrap.service").write_text(bootstrap)

    from provider_runtime.agent_runtime.neon_config import NEON_CATALOG_REVISION

    from jarvis.definitions import load_session_manifest

    manifest = load_session_manifest().google_neon
    if manifest.catalog_revision != NEON_CATALOG_REVISION:
        raise RuntimeError("paid catalog differs from the packaged manifest")
    neon = config.google_neon
    adapter = (release / "deploy/jarvis-neon-adapter.service").read_text()
    for marker, value in {
        "@RELEASE@": str(release),
        "@ADAPTER_USER@": NEON_ADAPTER_USER,
        "@CREDENTIAL_NAME@": neon.credential_name,
        "@PROJECT@": neon.project_id,
        "@ORIGIN@": neon.adapter_origin,
        "@CONTROL@": str(NEON_CONTROL_SOCKET),
        "@MODEL_VERSION@": manifest.model_version,
    }.items():
        adapter = adapter.replace(marker, value)
    (output / "jarvis-neon-adapter.service").write_text(adapter)


def stock_unit(key: str) -> str:
    return (
        "jarvis-codex-contained.service"
        if key == "personal"
        else "jarvis-codex-contained-neon.service"
    )


if __name__ == "__main__":
    if len(sys.argv) not in (2, 3):
        raise SystemExit(
            "usage: codex-host start|publish|verify|cleanup|bootstrap-notes PROFILE"
            " | render DIR | verify-notes-acl"
        )
    command, *arguments = sys.argv[1:]
    mapping = Path(
        os.environ.get("JARVIS_CODEX_HOST_CONFIG_PATH", "/etc/jarvis/codex-host.json")
    )
    config = CodexHostConfig.load(mapping)
    if command == "verify-notes-acl" and not arguments:
        verify_notes_acl(config)
        raise SystemExit(0)
    if len(arguments) != 1:
        raise SystemExit("contained Codex host operation requires one argument")
    argument = arguments[0]
    if command == "render":
        render_units(config, mapping, Path(argument))
        raise SystemExit(0)
    account = {"personal": config.personal, "google_neon": config.google_neon}.get(
        argument
    )
    if account is None:
        raise SystemExit("unknown contained Codex account")
    match command:
        case "start":
            start(config, account)
        case "publish":
            asyncio.run(publish(config, account))
        case "verify":
            verify_release(argument)
            asyncio.run(verify(config, account))
        case "cleanup":
            remove_alias(config, account)
        case "bootstrap-notes" if isinstance(account, CodexAccount):
            bootstrap_notes(config, account)
        case _:
            raise SystemExit("unknown contained Codex host operation")
