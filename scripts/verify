#!/usr/bin/env bash
set -euo pipefail

uv lock --check
uv sync --frozen --all-groups
git diff --check
cutover_tools=(deploy/prepare-cutover deploy/drive-export deploy/drive-import)
uv run ruff format --check . "${cutover_tools[@]}"
uv run ruff check . "${cutover_tools[@]}"
uv run pyright
uv run python scripts/check_docs.py

artifact_directory="$(mktemp -d)"
install_environment="$(mktemp -d)"
trap 'rm -rf -- "$artifact_directory" "$install_environment"' EXIT

uv build --out-dir "$artifact_directory"
wheels=("$artifact_directory"/*.whl)
sdists=("$artifact_directory"/*.tar.gz)
test "${#wheels[@]}" -eq 1
test "${#sdists[@]}" -eq 1
test -f "${wheels[0]}"
test -f "${sdists[0]}"
uv venv --python "$(cat .python-version)" "$install_environment"
uv pip install --python "$install_environment/bin/python" "${wheels[0]}"
"$install_environment/bin/python" - <<'PY'
from jarvis.definitions import load_session_manifest, verify_runtime_dependencies

verify_runtime_dependencies()
load_session_manifest()
PY
"$install_environment/bin/jarvis" --help >/dev/null
uv run pip-audit --local
echo "static and build checks passed; scoped memory regressions run separately"
