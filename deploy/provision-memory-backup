#!/usr/bin/env bash
set -euo pipefail
if [[ $# -lt 3 || "$1" != --change || ! "$2" =~ ^[0-9a-f-]{36}$ || ! "$3" =~ ^[0-9a-f]{40}$ ]]; then
  printf 'usage: deploy/provision-memory-backup --change ID TARGET [--reader-image DIGEST] [--repair-of ID]\n' >&2
  exit 64
fi
change_id=$2
commit=$3
shift 3
repo_dir="$(cd "$(dirname "$0")/.." && pwd -P)"
operation=backup
if [[ "${1:-}" == --reader-image ]]; then
  [[ "$2" =~ ^sha256:[0-9a-f]{64}$ ]]
  operation=backup-reader
  reader=$2
  shift 2
fi
repair=()
if (( $# )); then
  [[ $# == 2 && "$1" == --repair-of && "$2" =~ ^[0-9a-f-]{36}$ ]]
  repair=(--repair-of "$2")
fi
release="/opt/jarvis/releases/$commit"
request() {
  if [[ "$operation" == backup ]]; then
    settings="${JARVIS_BACKUP_SETTINGS:?supply the private producer settings}"
    [[ -f "$settings" && ! -L "$settings" && "$(stat -f '%u:%Lp' "$settings")" == "$(id -u):600" ]] || return 1
    reader="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["reader_image"])' "$settings")"
    "$repo_dir/deploy/qualified-reader" "$reader" | python3 -c '
import json,sys
print(json.dumps({"settings": json.load(open(sys.argv[1])), "reader": json.load(sys.stdin)}))
' "$settings"
  else
    "$repo_dir/deploy/qualified-reader" "$reader"
  fi
}
# Complete the local qualification before an operation can reach the server.
umask 077
input="$(mktemp "${TMPDIR:-/tmp}/jarvis-backup-change.XXXXXXXX")"
trap 'rm -f -- "$input"' EXIT
request > "$input"
ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy sudo -n \
  systemd-run --quiet --wait --pipe --collect --property=Type=exec \
  /usr/bin/flock --exclusive /opt/jarvis/.deploy.lock \
  "$release/.venv/bin/python" "$release/deploy/provision-change" \
  "$operation" "$change_id" "$commit" "${repair[@]}" < "$input"
