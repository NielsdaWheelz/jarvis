#!/usr/bin/env bash
set -euo pipefail

target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
commit="${1:-}"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'usage: deploy/activate-release FULL_GIT_COMMIT\n' >&2
  exit 64
}

ssh "$target" bash -s -- "$commit" <<'REMOTE'
set -euo pipefail
commit="$1"
release="/opt/jarvis/releases/$commit"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
sudo test -f "$release/RELEASE.json"
for file in /etc/jarvis/database-runtime.env /etc/jarvis/jarvis.env \
  /etc/jarvis/migration.env; do
  sudo test -f "$file"
  sudo test ! -L "$file"
done

sudo systemctl stop jarvis.service 2>/dev/null || true
migration_unit="jarvis-migrate-${commit:0:12}-$RANDOM"
sudo systemd-run --quiet --wait --collect --unit="$migration_unit" \
  --property=Type=oneshot \
  --property=User=jarvis \
  --property=Group=jarvis \
  --property="WorkingDirectory=$release" \
  --property=EnvironmentFile=/etc/jarvis/migration.env \
  "$release/.venv/bin/alembic" -c alembic.ini upgrade head
if ! sudo test -f /var/lib/jarvis/runtime/paused.json && \
  ! sudo test -f /var/lib/jarvis/runtime/admission.json; then
  initialize_unit="jarvis-initialize-${commit:0:12}-$RANDOM"
  sudo systemd-run --quiet --wait --collect --unit="$initialize_unit" \
    --property=Type=oneshot \
    --property=User=jarvis \
    --property=Group=jarvis \
    --property="WorkingDirectory=$release" \
    --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
    --property=EnvironmentFile=/etc/jarvis/jarvis.env \
    "$release/.venv/bin/jarvis" initialize-state
else
  sudo test -f /var/lib/jarvis/runtime/paused.json
  sudo test -f /var/lib/jarvis/runtime/admission.json
fi

temporary="/opt/jarvis/.current-$commit"
sudo rm -f -- "$temporary"
sudo ln -s "releases/$commit" "$temporary"
sudo mv -Tf "$temporary" /opt/jarvis/current
sudo systemctl reset-failed jarvis.service
sudo systemctl enable --now jarvis.service
sleep 10
sudo test "$(sudo systemctl is-active jarvis.service)" = active
sudo test "$(sudo systemctl show --property=SubState --value jarvis.service)" = running
sudo test "$(sudo systemctl show --property=NRestarts --value jarvis.service)" = 0
main_pid="$(sudo systemctl show --property=MainPID --value jarvis.service)"
[[ "$main_pid" =~ ^[1-9][0-9]*$ ]]
printf 'Activated Jarvis release: %s\n' "$commit"
REMOTE
