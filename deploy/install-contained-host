#!/usr/bin/env bash
set -euo pipefail

target=dev-server-deploy
commit="${1:-}"
source_mapping="${JARVIS_SOURCE_CODEX_HOST_CONFIG:?supply the provisioned non-secret personal host mapping}"
if [[ ! "$commit" =~ ^[0-9a-f]{40}$ ]] || (($# != 1)); then
  printf 'usage: deploy/install-contained-host FULL_GIT_COMMIT\n' >&2
  exit 64
fi
[[ "$source_mapping" = /* && -f "$source_mapping" && ! -L "$source_mapping" ]] || {
  printf 'missing or unsafe contained host mapping source\n' >&2
  exit 1
}
remote="$(ssh -T -o BatchMode=yes -o ForwardAgent=no "$target" mktemp -d /tmp/jarvis-contained-host.XXXXXX)"
case "$remote" in /tmp/jarvis-contained-host.*) ;; *) exit 1 ;; esac
scp -q -o BatchMode=yes -o ForwardAgent=no "$source_mapping" "$target:$remote/codex-host.json"
ssh -T -o BatchMode=yes -o ForwardAgent=no "$target" sudo -n flock /opt/jarvis/.deploy.lock bash -s -- "$commit" "$remote" <<'REMOTE'
set -euo pipefail
commit="$1"
remote="$2"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
case "$remote" in /tmp/jarvis-contained-host.*) ;; *) exit 1 ;; esac
cleanup() { rm -rf -- "$remote"; }
trap cleanup EXIT HUP INT TERM
release="/opt/jarvis/releases/$commit"
sudo -n test -f "$release/RELEASE.json"
[[ -f "$remote/codex-host.json" && ! -L "$remote/codex-host.json" ]]

# host and mapping changes require a cleanly stopped application. existing native
# attempts are recovered by the application after its next activation.
[[ "$(sudo -n systemctl show --property=ActiveState --value jarvis.service)" == inactive ]]
[[ "$(sudo -n systemctl show --property=Result --value jarvis.service)" == success ]]
[[ "$(sudo -n systemctl show --property=MainPID --value jarvis.service)" == 0 ]]
candidate="$(sudo -n mktemp /etc/jarvis/.codex-host.XXXXXX)"
cleanup_candidate() { sudo -n rm -f -- "$candidate"; cleanup; }
trap cleanup_candidate EXIT HUP INT TERM
sudo -n install -m 0644 -o root -g root "$remote/codex-host.json" "$candidate"
mapfile -t layout < <(sudo -n "$release/.venv/bin/python" - \
  "$candidate" "$release" "$remote/jarvis-codex-contained.service" <<'PY'
import grp
import json
import pwd
import re
import stat
import sys
from pathlib import Path

from jarvis.codex_config import CodexHostConfig

config = CodexHostConfig.load(Path(sys.argv[1]))
if (
    config.jarvis_user != "jarvis"
    or config.client_group != "codex-clients"
    or not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", config.development_user)
    or config.endpoints["personal"] != Path("/run/jarvis-contained/app-server.sock")
    or config.cognition_cwd_parent != "/run/jarvis-codex-cognition"
    or config.notes_repository != "/var/lib/jarvis-notes"
):
    raise SystemExit("contained host mapping has an incompatible deployment layout")
host_uid = pwd.getpwnam(config.development_user).pw_uid
if host_uid == 0 or host_uid == pwd.getpwnam(config.jarvis_user).pw_uid:
    raise SystemExit("contained host and application require distinct non-root identities")
account = Path(config.profiles["personal"].account_home)
metadata = account.stat()
if (
    not stat.S_ISDIR(metadata.st_mode)
    or metadata.st_uid != host_uid
    or stat.S_IMODE(metadata.st_mode) != 0o700
    or not (account / "auth.json").is_file()
):
    raise SystemExit("original personal account must be private and host-owned")
release = Path(sys.argv[2])
unit = (release / "deploy/jarvis-codex-contained.service").read_text()
for key, value in {
    "@HOST_USER@": config.development_user,
    "@RELEASE@": str(release),
    "@ACCOUNT_HOME@": json.dumps(str(account).replace("%", "%%"), ensure_ascii=False),
    "@ACCOUNT_INSTRUCTIONS@": " ".join(
        json.dumps(f"-{account / name}".replace("%", "%%"), ensure_ascii=False)
        for name in ("AGENTS.override.md", "AGENTS.md")
    ),
}.items():
    unit = unit.replace(key, value)
Path(sys.argv[3]).write_text(unit)
application = (release / "deploy/jarvis.service").read_text().replace(
    "/opt/jarvis/current", str(release)
)
Path(sys.argv[3]).with_name("jarvis.service").write_text(application)
# Bootstrap uses this same host namespace, identity and restrictions. Only the
# command, its startup deadline and candidate mapping source differ.
bootstrap = unit.replace("Type=exec\n", "Type=oneshot\n").replace(
    "Restart=on-failure\n", "Restart=no\n"
).replace("TimeoutStartSec=20\n", "TimeoutStartSec=180\n")
bootstrap = bootstrap.replace(
    f"{release}/deploy/codex-host start\n",
    f"{release}/deploy/codex-host bootstrap-notes\n",
).replace(
    "BindReadOnlyPaths=/etc/jarvis/codex-host.json:",
    f"BindReadOnlyPaths={sys.argv[1]}:",
)
bootstrap = "\n".join(
    line for line in bootstrap.splitlines()
    if not line.startswith(("ExecStartPost=", "ExecStopPost="))
) + "\n"
Path(sys.argv[3]).with_name("jarvis-notes-bootstrap.service").write_text(bootstrap)
notes = Path(config.notes_repository)
if notes.exists() or notes.is_symlink():
    metadata = notes.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != host_uid
        or metadata.st_gid != grp.getgrnam(config.client_group).gr_gid
        or stat.S_IMODE(metadata.st_mode) not in (0o750, 0o2750)
    ):
        raise SystemExit("existing notes directory needs ownership/mode repair")
print(config.development_user)
print(account)
PY
)
[[ "${#layout[@]}" == 2 ]]
host_user="${layout[0]}"
account_home="${layout[1]}"
sudo -n -u "$host_user" test -r "$account_home/auth.json"
if sudo -n -u jarvis test -r "$account_home/auth.json"; then
  printf 'application can read the native host account; installation refused\n' >&2
  exit 1
fi
sudo -n systemd-analyze verify "$remote/jarvis-codex-contained.service"
sudo -n systemd-analyze verify "$remote/jarvis.service"
sudo -n systemd-analyze verify "$remote/jarvis-notes-bootstrap.service"
if sudo -n systemctl cat jarvis-codex-contained.service >/dev/null 2>&1; then
  sudo -n systemctl stop jarvis-codex-contained.service
fi
sudo -n install -d -m 0710 -o "$host_user" -g codex-clients /run/jarvis-contained
sudo -n install -d -m 0700 -o "$host_user" -g codex-clients /run/jarvis-contained/exec
sudo -n install -d -m 02750 -o jarvis -g codex-clients /run/jarvis-codex-cognition
sudo -n install -d -m 0750 -o jarvis -g codex-clients \
  /var/cache/jarvis /var/cache/jarvis/attachments
if ! sudo -n test -e /var/lib/jarvis-notes; then
  sudo -n install -d -m 02750 -o "$host_user" -g codex-clients /var/lib/jarvis-notes
fi
bootstrap_unit=/run/systemd/system/jarvis-notes-bootstrap.service
[[ ! -e "$bootstrap_unit" && ! -L "$bootstrap_unit" ]]
cleanup_candidate() {
  sudo -n systemctl stop jarvis-notes-bootstrap.service >/dev/null 2>&1 || true
  sudo -n rm -f -- "$candidate" "$bootstrap_unit"
  sudo -n systemctl daemon-reload
  cleanup
}
trap cleanup_candidate EXIT HUP INT TERM
sudo -n install -m 0644 -o root -g root "$remote/jarvis-notes-bootstrap.service" "$bootstrap_unit"
sudo -n systemctl daemon-reload
sudo -n systemctl start jarvis-notes-bootstrap.service
sudo -n systemctl stop jarvis-notes-bootstrap.service
sudo -n rm -f -- "$bootstrap_unit"
sudo -n -u jarvis -g codex-clients test -r /var/lib/jarvis-notes
sudo -n -u jarvis -g codex-clients test -x /var/lib/jarvis-notes
sudo -n -u jarvis -g codex-clients test -r /var/lib/jarvis-notes/.git
sudo -n -u jarvis -g codex-clients test -x /var/lib/jarvis-notes/.git
printf 'd /run/jarvis-codex-cognition 2750 jarvis codex-clients -\n' | \
  sudo -n tee /etc/tmpfiles.d/jarvis-codex-contained.conf >/dev/null
sudo -n mv -fT -- "$candidate" /etc/jarvis/codex-host.json
sudo -n install -m 0644 -o root -g root \
  "$remote/jarvis-codex-contained.service" /etc/systemd/system/jarvis-codex-contained.service
sudo -n install -m 0644 -o root -g root \
  "$remote/jarvis.service" /etc/systemd/system/jarvis.service
sudo -n systemctl daemon-reload
sudo -n systemctl enable --now jarvis-codex-contained.service
sudo -n systemctl is-active --quiet jarvis-codex-contained.service
sudo -n systemd-run --quiet --wait --pipe --collect \
  --property=Type=oneshot --property=User=jarvis --property=Group=jarvis \
  --property=SupplementaryGroups=codex-clients \
  --property=ProtectHome=true --property=ProtectSystem=strict \
  --property=PrivateTmp=true --property=PrivateDevices=true \
  --property=NoNewPrivileges=true \
  --property=BindsTo=jarvis-codex-contained.service \
  --property=After=jarvis-codex-contained.service \
  --property=BindReadOnlyPaths=/run/jarvis-contained/exec/app-server.sock:/run/jarvis-contained/app-server.sock \
  "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6" \
  --property=Environment=JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json \
  "$release/.venv/bin/python" "$release/deploy/codex-host" verify </dev/null
printf 'contained personal host installed for %s; jarvis remains stopped\n' "$commit"
REMOTE
