#!/usr/bin/env bash
set -euo pipefail

target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"

ssh "$target" bash -s <<'REMOTE'
set -euo pipefail
files=(
  /etc/jarvis/database-runtime.env
  /etc/jarvis/migration.env
)
present=0
for file in "${files[@]}"; do
  if sudo test -e "$file"; then
    sudo test -f "$file"
    sudo test ! -L "$file"
    present=$((present + 1))
  fi
done
if ((present != 0 && present != ${#files[@]})); then
  printf 'refusing partial Jarvis database credential state\n' >&2
  exit 1
fi

if ((present == 0)); then
  if sudo -n -u postgres psql -Atd postgres -c \
    "SELECT 1 FROM pg_database WHERE datname = 'jarvis'" | grep -Fxq 1; then
    printf 'refusing existing Jarvis database without credential state\n' >&2
    exit 1
  fi
  runtime_password="$(openssl rand -hex 32)"
  migrator_password="$(openssl rand -hex 32)"
  sudo -n -u postgres psql -v ON_ERROR_STOP=1 -d postgres <<SQL
CREATE ROLE jarvis_migrator LOGIN PASSWORD '$migrator_password';
CREATE ROLE jarvis_runtime LOGIN PASSWORD '$runtime_password';
SQL
  sudo -n -u postgres createdb --owner=jarvis_migrator jarvis
  sudo -n -u postgres psql -v ON_ERROR_STOP=1 -d jarvis <<'SQL'
REVOKE ALL ON DATABASE jarvis FROM PUBLIC;
GRANT CONNECT ON DATABASE jarvis TO jarvis_migrator, jarvis_runtime;
CREATE EXTENSION vector;
SQL

  scratch="$(mktemp -d /tmp/jarvis-database.XXXXXX)"
  cleanup() {
    case "$scratch" in
    /tmp/jarvis-database.*) rm -rf -- "$scratch" ;;
    *) return 1 ;;
    esac
  }
  trap cleanup EXIT HUP INT TERM
  umask 077
  printf 'JARVIS_DATABASE_URL=postgresql+psycopg://jarvis_runtime:%s@127.0.0.1:5432/jarvis\n' \
    "$runtime_password" >"$scratch/database-runtime.env"
  printf 'JARVIS_MIGRATION_DATABASE_URL=postgresql+psycopg://jarvis_migrator:%s@127.0.0.1:5432/jarvis\n' \
    "$migrator_password" >"$scratch/migration.env"
  sudo install -m 0640 -o root -g jarvis \
    "$scratch/database-runtime.env" /etc/jarvis/database-runtime.env
  sudo install -m 0640 -o root -g jarvis \
    "$scratch/migration.env" /etc/jarvis/migration.env
fi

sudo -n -u postgres psql -Atd jarvis -c "SHOW TimeZone" | grep -Fxq UTC
sudo -n -u postgres psql -Atd jarvis -c \
  "SELECT extversion FROM pg_extension WHERE extname = 'vector'" | grep -Fxq 0.8.6
for role in jarvis_migrator jarvis_runtime; do
  sudo -n -u postgres psql -Atd postgres -c \
    "SELECT 1 FROM pg_roles WHERE rolname = '$role' AND rolcanlogin" | grep -Fxq 1
done
printf 'Jarvis database boundary is ready.\n'
REMOTE
