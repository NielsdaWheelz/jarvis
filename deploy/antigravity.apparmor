abi <abi/4.0>,
include <tunables/global>

# The sandbox re-executes the bundled binary across a private mount.
# Use a separate name prefix so disconnected objects cannot alias normal paths.
profile jarvis-antigravity-localharness "@BINARY@" flags=(mediate_deleted,attach_disconnected,attach_disconnected.path=/jarvis-sdk-disconnected) {
  /** rwklm,
  "@BINARY@" ix,
  /proc/self/exe ix,
  "/jarvis-sdk-disconnected@BINARY@" ix,
  /jarvis-sdk-disconnected/proc/self/exe ix,
  deny /jarvis-sdk-disconnected/** wl,
  /usr/bin/bwrap ix,
  /{,usr/}bin/{sh,bash,dash} px -> jarvis-antigravity-tool,
  capability,
  network,
  unix,
  signal,
  ptrace,
  mount,
  umount,
  pivot_root,
  userns,
  deny /var/lib/jarvis-notes/.git/ wl,
  deny /var/lib/jarvis-notes/.git/{commondir,config.worktree} wl,
}

profile jarvis-antigravity-tool flags=(mediate_deleted) {
  /** rwklmix,
  network,
  unix,
  signal,
  deny capability,
  deny userns,
  deny /var/lib/jarvis-notes/.git/ wl,
  deny /var/lib/jarvis-notes/.git/{commondir,config.worktree} wl,
}
