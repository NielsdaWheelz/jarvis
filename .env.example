# Assistant runtime example for local development.
# deploy/install-private-state takes the qualified raw .secrets/jarvis.slice0.env.
JARVIS_DATABASE_URL=postgresql://jarvis_runtime:jarvis-runtime-dev@127.0.0.1:54328/jarvis
# Immutable owner identity: the stored channel scope and its exact memory archive key.
JARVIS_OWNER_SCOPE=100000000000000003
JARVIS_OWNER_ARCHIVE_KEY=discord:100000000000000002:100000000000000003
# Dedicated Firebase project. Omit to leave notices pending.
# JARVIS_FCM_PROJECT_ID=your-jarvis-project
JARVIS_OWNER_TIMEZONE=America/Los_Angeles
JARVIS_CODEX_PROFILE_KEY=personal
JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json
JARVIS_AGENT_CLI_PATH=/usr/local/libexec/skidbladnir
JARVIS_AGENT_STATE_DIRECTORY=/run/jarvis-skid-state
JARVIS_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
# no workspace project means no gmail or calendar provider access.
# set JARVIS_WORKSPACE_PROJECT_ID only for the isolated qualification project.
# the production project is held in this release. enroll the test grant in situ.
JARVIS_GOOGLE_OAUTH_STATE_PATH=/var/lib/jarvis/secrets/google-oauth-state.json
JARVIS_GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
JARVIS_GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-client-secret
JARVIS_CONNECTOR_ENCRYPTION_KEY_VERSION=v2
JARVIS_CONNECTOR_ENCRYPTION_SECRET=replace-with-qualified-base64url-secret
JARVIS_MAPS_API_KEY=replace-with-maps-api-key
JARVIS_BRAVE_API_KEY=replace-with-brave-api-key
JARVIS_MEMORY_CONFIG_PATH=/etc/jarvis/memory.json
JARVIS_MEMORY_NIGHTLY_TIME=03:00
JARVIS_MAXIMUM_BATCH_SIZE=20
JARVIS_DELIVERY_BATCH_SIZE=20

# Bounded native file scratch, shared read-only with the contained host.
JARVIS_FILE_SCRATCH_DIRECTORY=/var/cache/jarvis/files
