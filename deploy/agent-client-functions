# shellcheck shell=bash
# caller runs as root; installation holds /opt/jarvis/.deploy.lock.
verify_agent_client() {
  local cli="$1" state="$2" output status=0 options flag
  [[ -f "$cli" && ! -L "$cli" ]]
  [[ "$(stat -c '%U:%G:%a' "$cli")" == root:root:755 ]]
  [[ "$(stat -c '%U:%G:%a' "$state")" == jarvis:jarvis:700 ]]
  options="$(findmnt --mountpoint "$state" -n -o VFS-OPTIONS)"
  for flag in ro nosuid nodev noexec; do
    case ",$options," in *",$flag,"*) ;; *) return 1 ;; esac
  done
  # The real CLI reads the live mounted state under the application's boundary.
  output="$(systemd-run --quiet --wait --pipe --collect \
    --property=User=jarvis --property=Group=jarvis \
    --property=ProtectHome=true --property=ProtectSystem=strict \
    --property=PrivateTmp=true --property=PrivateDevices=true \
    --property=NoNewPrivileges=true \
    --property=AmbientCapabilities= --property=CapabilityBoundingSet= \
    '--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6' \
    --property=RuntimeMaxSec=25 \
    /usr/bin/env -i PATH=/usr/bin:/bin \
    "$cli" --config "$state" list --json </dev/null 2>/dev/null)" || status=$?
  printf '%s' "$output" | python3 -c '
import json
import sys

value = json.load(sys.stdin)
assert value["ok"] is True, "worker inventory failed"
inventory = value["result"]
peers = inventory["peers"]
assert len(peers) == 3 and {p["label"] for p in peers} == {
    "dev-server", "macbook", "arch"
}, "worker inventory differs from the enrolled fleet"
failed = [p for p in peers if p["ok"] is False]
assert inventory["partial"] is bool(failed), "inconsistent partial inventory"
assert int(sys.argv[1]) == (1 if failed else 0), "unexpected worker exit status"
for peer in peers:
    machine = peer["label"]
    if peer["ok"] is True:
        print(f"agent gateway read passed: {machine}")
    else:
        assert machine == "arch" and peer["error"]["code"] == "unavailable", (
            "required worker gateway read failed"
        )
        print("agent gateway read deferred: arch unavailable")
' "$status"
}
