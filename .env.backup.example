# `/etc/jarvis/backup-database.env` supplies read-only PG* settings for backup.
# A clean restore instead loads `/etc/jarvis/restore-database.env`, which carries
# the migrator's PG* settings. This file becomes `/etc/jarvis/backup.env`.
RESTIC_REPOSITORY=s3:https://<cloudflare-account-id>.r2.cloudflarestorage.com/<jarvis-backup-bucket>/<jarvis-only-prefix>
RESTIC_PASSWORD_FILE=/etc/jarvis/restic-password
RESTIC_CACHE_DIR=/var/lib/jarvis/restic-cache
AWS_ACCESS_KEY_ID=replace-with-jarvis-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-jarvis-backup-only-secret-key
JARVIS_RELEASE_METADATA_PATH=/opt/jarvis/current/RELEASE.json
JARVIS_BACKUP_CONNECTOR_STATE_PATH=/var/lib/jarvis/connectors/google-oauth-state.json
JARVIS_BACKUP_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
JARVIS_BACKUP_STAGING_DIRECTORY=/var/lib/jarvis/backup-staging
# Restore commands additionally require these two paths.
JARVIS_RESTORE_STATE_ROOT=/var/lib/jarvis
JARVIS_RESTORE_STAGING_DIRECTORY=/var/lib/jarvis/restore-staging
