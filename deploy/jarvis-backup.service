[Unit]
Description=Encrypted off-host Jarvis backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=jarvis
Group=jarvis
EnvironmentFile=/etc/jarvis/backup-database.env
EnvironmentFile=/etc/jarvis/backup.env
Environment=JARVIS_RELEASE_METADATA_PATH=/opt/jarvis/current/RELEASE.json
ExecStart=/opt/jarvis/current/.venv/bin/jarvis-backup
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/var/lib/jarvis
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
TasksMax=64
CPUQuota=100%
MemoryMax=1G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
