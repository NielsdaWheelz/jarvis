# shellcheck shell=bash
# caller holds /opt/jarvis/.deploy.lock as root.
# shellcheck disable=SC2034
CODEX_PROFILES=(personal google_neon)
# The streamed release installer supplies this same release asset before stdin.
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
  NATIVE_HOST_UNITS=()
  while IFS= read -r unit_name; do NATIVE_HOST_UNITS+=("$unit_name"); done \
    <"${BASH_SOURCE[0]%/*}/native-host-units"
fi
CODEX_HOST_UNITS=("${NATIVE_HOST_UNITS[@]:0:2}")
NEON_GATEWAY_UNIT="${NATIVE_HOST_UNITS[2]}"
# shellcheck disable=SC2034
CODEX_SOCKET_ROOTS=(/run/jarvis-contained /run/jarvis-contained-neon)
CODEX_SOCKET_PROPERTIES=(
  --property=BindsTo=jarvis-codex-contained.service
  "--property=After=${NATIVE_HOST_UNITS[*]}"
  --property=BindReadOnlyPaths=/run/jarvis-contained/exec/app-server.sock:/run/jarvis-contained/app-server.sock
  --property=BindReadOnlyPaths=-/run/jarvis-contained-neon/exec/app-server.sock:/run/jarvis-contained-neon/app-server.sock
)

verify_native_account() {
  local release="$1" profile="$2"
  systemd-run --quiet --wait --pipe --collect \
    --property=Type=oneshot --property=User=jarvis --property=Group=jarvis \
    --property=SupplementaryGroups=codex-clients \
    --property=ProtectHome=true --property=ProtectSystem=strict \
    --property=PrivateTmp=true --property=PrivateDevices=true \
    --property=NoNewPrivileges=true \
    "${CODEX_SOCKET_PROPERTIES[@]}" \
    "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6" \
    --property=Environment=JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json \
    "$release/.venv/bin/python" "$release/deploy/codex-host" verify "$profile" </dev/null
}

require_no_cutover_hold() {
  local hold="${1:-/var/lib/jarvis-cutover/held}" change
  if [[ -e "$hold" || -L "$hold" || -e /etc/systemd/system/jarvis-cutover.hold ]]; then
    change="$(python3 - "$hold" <<'PYCODE'
import json
import sys
from pathlib import Path
from uuid import UUID

try:
    value = json.loads((Path(sys.argv[1]) / 'receipt.json').read_bytes())
    print(UUID(value['binding']['id']))
except (OSError, KeyError, TypeError, ValueError):
    print('unknown')
PYCODE
)"
    printf 'deployment hold %s prevents this operation\n' "$change" >&2
    return 1
  fi
}

check_release_schema() {
  local release="$1"
  shift
  systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
    "--property=WorkingDirectory=$release" \
    --property=EnvironmentFile=/etc/jarvis/migration.env \
    "$release/.venv/bin/python" "$release/deploy/cutover-hold" inspect-database "$@"
}

deployment_runtime_check() {
  local release="$1" extra_count="$2"
  shift 2
  local -a properties=(
    --property=Type=oneshot --property=User=jarvis --property=Group=jarvis
    "--property=SupplementaryGroups=codex-clients jarvis-memory"
    --property=ProtectHome=true --property=ProtectSystem=strict
    --property=PrivateTmp=true --property=PrivateDevices=true
    --property=NoNewPrivileges=true
    "${CODEX_SOCKET_PROPERTIES[@]}"
    "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6"
    "--property=ReadWritePaths=/var/lib/jarvis /run/jarvis-codex-cognition /var/cache/jarvis/files"
    "--property=WorkingDirectory=$release"
    --property=EnvironmentFile=/etc/jarvis/database-runtime.env
    --property=EnvironmentFile=/etc/jarvis/jarvis.env
  )
  if [[ -n "${MAINTENANCE_MEMORY_CONFIG:-}" ]]; then
    properties+=("--property=BindReadOnlyPaths=$MAINTENANCE_MEMORY_CONFIG:/etc/jarvis/memory.json")
  fi
  if [[ -n "${MAINTENANCE_GOOGLE_STATE:-}" ]]; then
    properties+=("--property=BindReadOnlyPaths=$MAINTENANCE_GOOGLE_STATE:/var/lib/jarvis/connectors/google-oauth-state.json")
  fi
  while ((extra_count > 0)); do
    properties+=("--property=EnvironmentFile=$1")
    shift
    extra_count=$((extra_count - 1))
  done
  systemd-run --quiet --wait --pipe --collect "${properties[@]}" "$@"
}

check_maintenance() {
  local release="$1" input="$2" output="$3"
  shift 3
  deployment_runtime_check "$release" "$#" "$@" \
    "$release/.venv/bin/jarvis" check-activation --maintenance <"$input" >"$output"
}

check_source_activation() {
  local release="$1"
  MAINTENANCE_MEMORY_CONFIG='' MAINTENANCE_GOOGLE_STATE='' deployment_runtime_check "$release" 0 \
    "$release/.venv/bin/jarvis" check-activation </dev/null
}

safe_source_return() {
  python3 - "$1" <<'PYCODE'
import json
import sys

try:
    with open(sys.argv[1]) as stream:
        value = json.load(stream)
    conflicts = [row for row in value["findings"] if row["verdict"] != "compatible"]
    allowed = value["control"] is not None and value["outcome"] == "blocked" and conflicts and all(
        row["source_start_safe"] is True for row in conflicts
    )
except (KeyError, OSError, TypeError, ValueError):
    allowed = False
raise SystemExit(0 if allowed else 1)
PYCODE
}

prune_releases() {
  local candidate="${1:-}" selected='' release main_pid
  local host_unit host_path host_state host_pid host_control_pid host_executable host_release
  require_no_cutover_hold || return 1
  if [[ -n "$candidate" && ! "$candidate" =~ ^[0-9a-f]{40}$ ]]; then
    printf 'invalid staged release commit\n' >&2
    return 1
  fi
  if [[ -L /opt/jarvis/current ]]; then
    selected="$(readlink -e /opt/jarvis/current)" || return 1
    if [[ ! "$selected" =~ ^/opt/jarvis/releases/[0-9a-f]{40}$ ||
      ! -f "$selected/RELEASE.json" ]]; then
      printf 'current does not select an installed jarvis release\n' >&2
      return 1
    fi
    main_pid="$(systemctl show --property=MainPID --value jarvis.service)" || return 1
    if [[ "$main_pid" != 0 &&
      "$(readlink -e "/proc/$main_pid/cwd")" != "$selected" ]]; then
      printf 'running jarvis process does not match current; refusing cleanup\n' >&2
      return 1
    fi
  elif [[ -e /opt/jarvis/current || -z "$candidate" ]]; then
    printf 'current release is missing or is not a symlink\n' >&2
    return 1
  fi

  # Memory can outlive the assistant and its native host. Protect its cwd.
  if systemctl cat jarvis-memory.service >/dev/null 2>&1; then
    local memory_pid memory_release
    memory_pid="$(systemctl show -p MainPID --value jarvis-memory.service)" || return 1
    if [[ "$memory_pid" != 0 ]]; then
      memory_release="$(readlink -e "/proc/$memory_pid/cwd")" || return 1
      if [[ "$memory_release" != "$selected" && "$memory_release" != "/opt/jarvis/releases/$candidate" ]]; then
        printf 'memory service still owns an unretained release\n' >&2
        return 1
      fi
    fi
  fi

  for host_unit in "${NATIVE_HOST_UNITS[@]}"; do
    host_state="$(systemctl show --property=ActiveState --value "$host_unit")" || return 1
    host_pid="$(systemctl show --property=MainPID --value "$host_unit")" || return 1
    host_control_pid="$(systemctl show --property=ControlPID --value "$host_unit")" || return 1
    if [[ "$host_state" == inactive && "$host_pid" == 0 && "$host_control_pid" == 0 ]]; then
      continue
    fi
    host_path="${host_unit//-/_2d}"
    host_path="${host_path//./_2e}"
    host_executable="$(busctl --system --json=short get-property \
      org.freedesktop.systemd1 "/org/freedesktop/systemd1/unit/$host_path" \
      org.freedesktop.systemd1.Service ExecStart | python3 -c '
import json, sys
value = json.load(sys.stdin)
if value["type"] != "a(sasbttttuii)" or len(value["data"]) != 1:
    raise SystemExit("contained host has an unsupported loaded ExecStart")
print(value["data"][0][0])
')" || return 1
    if [[ ! "$host_executable" =~ ^/opt/jarvis/releases/[0-9a-f]{40}/\.venv/bin/python$ ]]; then
      printf 'contained host does not select an installed release; refusing cleanup\n' >&2
      return 1
    fi
    host_release="${host_executable%/.venv/bin/python}"
    if [[ "$host_release" != "$selected" && "${host_release##*/}" != "$candidate" ]]; then
      printf 'contained host still selects an unretained release; refusing cleanup\n' >&2
      return 1
    fi
  done

  for release in /opt/jarvis/releases/*; do
    [[ -d "$release" && "${release##*/}" =~ ^[0-9a-f]{40}$ ]] || continue
    [[ "$release" == "$selected" || "${release##*/}" == "$candidate" ]] && continue
    rm -rf -- "$release" || return 1
    printf 'removed inactive jarvis release: %s\n' "${release##*/}"
  done
}
