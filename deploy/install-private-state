#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
release=/opt/jarvis/current
if [[ $# == 2 && "$1" == --bootstrap && "$2" =~ ^[0-9a-f]{40}$ ]]; then
  release=/opt/jarvis/releases/$2
  operation=bootstrap
  change_id=$2
  repair=()
elif [[ ( $# == 2 || $# == 4 ) && "$1" == --change && "$2" =~ ^[0-9a-f-]{36}$ ]]; then
  operation=private-state
  change_id=$2
  repair=()
  if (( $# == 4 )); then
    [[ "$3" == --repair-of && "$4" =~ ^[0-9a-f-]{36}$ ]]
    repair=(--repair-of "$4")
  fi
else
  printf 'usage: deploy/install-private-state --change ID [--repair-of ID] | --bootstrap FRESH_RELEASE_COMMIT\n' >&2
  exit 64
fi
target=dev-server-deploy
source_environment="${JARVIS_SOURCE_ENVIRONMENT:-$repo_dir/.secrets/jarvis.slice0.env}"
source_memory="${JARVIS_SOURCE_MEMORY_CONFIG:-$repo_dir/deploy/memory-config.example.json}"

for path in "$source_environment" "$source_memory"; do
  [[ "$path" = /* && -f "$path" && ! -L "$path" ]] || {
    printf 'missing or unsafe private deployment source: %s\n' "$path" >&2
    exit 1
  }
done

scratch="$(mktemp -d "${TMPDIR:-/tmp}/jarvis-private-state.XXXXXX")"
cleanup() {
  case "$scratch" in
  "${TMPDIR:-/tmp}"/jarvis-private-state.*) rm -rf -- "$scratch" ;;
  *) return 1 ;;
  esac
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$scratch"
umask 077

uv run --project "$repo_dir" --frozen --no-dev python - \
  "$source_environment" "$scratch/jarvis.env" <<'PY'
import pathlib
import re
import sys

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
required = {
    "JARVIS_BRAVE_API_KEY",
    "JARVIS_OWNER_SCOPE",
    "JARVIS_OWNER_ARCHIVE_KEY",
    "JARVIS_EMBEDDING_OPENAI_API_KEY",
    "JARVIS_MAPS_API_KEY",
}
allowed = required | {
    "JARVIS_WORKSPACE_PROJECT_ID", "JARVIS_GOOGLE_OAUTH_CLIENT_ID",
    "JARVIS_GOOGLE_OAUTH_CLIENT_SECRET", "JARVIS_CONNECTOR_ENCRYPTION_KEY_VERSION",
    "JARVIS_CONNECTOR_ENCRYPTION_SECRET",
}
raw = source.read_bytes()
if b"\x00" in raw:
    raise SystemExit("private environment contains a NUL byte")
text = raw.decode("utf-8")
names = []
for line in text.splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
    if match is None:
        raise SystemExit("private environment has an unsupported line")
    names.append(match.group(1))
if len(names) != len(set(names)) or set(names) - allowed or required - set(names):
    raise SystemExit("private environment key roster is incompatible")

static = """\
JARVIS_OWNER_TIMEZONE=America/Los_Angeles
JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json
JARVIS_AGENT_CLI_PATH=/usr/local/libexec/skidbladnir
JARVIS_AGENT_STATE_DIRECTORY=/run/jarvis-skid-state
JARVIS_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
JARVIS_FILE_SCRATCH_DIRECTORY=/var/cache/jarvis/files
JARVIS_GOOGLE_OAUTH_STATE_PATH=/var/lib/jarvis/connectors/google-oauth-state.json
JARVIS_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_EMBEDDING_DIMENSION=1536
JARVIS_MEMORY_CONFIG_PATH=/etc/jarvis/memory.json
JARVIS_MEMORY_HTTP_PORT=8768
JARVIS_MEMORY_NIGHTLY_TIME=03:00
JARVIS_MAXIMUM_BATCH_SIZE=20
JARVIS_DELIVERY_BATCH_SIZE=20
"""
target.write_bytes(raw.rstrip(b"\n") + b"\n" + static.encode("utf-8"))
target.chmod(0o600)
PY

uv run --project "$repo_dir" --frozen --no-dev python - \
  "$source_memory" "$scratch/memory.json" <<'PY'
import pathlib
import shutil
import sys

from jarvis.config import ConfigurationError
from jarvis.memory_config import MemoryConfig

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
try:
    MemoryConfig.load(source)
except ConfigurationError:
    raise SystemExit("memory declaration is invalid") from None
shutil.copyfile(source, target)
target.chmod(0o600)
PY


owner="${JARVIS_AGENT_STATE_OWNER:?supply the enrolled account}"
source_state="${JARVIS_AGENT_SOURCE_STATE_DIRECTORY:?supply the enrolled state path}"
source_cli="${JARVIS_AGENT_SOURCE_CLI:?supply the enrolled executable}"
[[ "$owner" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
for path in "$source_state" "$source_cli"; do [[ "$path" =~ ^/[a-zA-Z0-9_./-]+$ ]]; done
if [[ "$operation" == private-state ]]; then
  selected="$(ssh -T -o BatchMode=yes -o ForwardAgent=no "$target" readlink -e /opt/jarvis/current)"
  [[ "$selected" =~ ^/opt/jarvis/releases/[0-9a-f]{40}$ ]]
  release="$selected"
fi
python3 - "$scratch" "$owner" "$source_state" "$source_cli" <<'PYCODE' |
import json
import sys
from pathlib import Path
stage = Path(sys.argv[1])
payload = {name: (stage / name).read_text() for name in ("jarvis.env", "memory.json")}
payload["agent"] = sys.argv[2:]
json.dump(payload, sys.stdout)
PYCODE
ssh -T -o BatchMode=yes -o ForwardAgent=no "$target" sudo -n \
  systemd-run --quiet --wait --pipe --collect --property=Type=exec \
  /usr/bin/flock --exclusive /opt/jarvis/.deploy.lock \
  "$release/.venv/bin/python" "$release/deploy/provision-change" \
  "$operation" "$change_id" "${release##*/}" "${repair[@]}"
