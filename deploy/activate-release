#!/usr/bin/env bash
set -euo pipefail

target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
commit="${1:-}"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || {
  printf 'usage: deploy/activate-release FULL_GIT_COMMIT\n' >&2
  exit 64
}

ssh "$target" bash -s -- "$commit" <<'REMOTE'
set -euo pipefail
commit="$1"
release="/opt/jarvis/releases/$commit"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]
sudo test -f "$release/RELEASE.json"
for file in /etc/jarvis/database-runtime.env /etc/jarvis/jarvis.env \
  /etc/jarvis/migration.env /etc/jarvis/backup-database.env \
  /etc/jarvis/backup.env /etc/jarvis/restic-password; do
  sudo test -f "$file"
  sudo test ! -L "$file"
done

sudo systemctl stop jarvis.service 2>/dev/null || true
sudo -u jarvis bash -c \
  'set -a; source /etc/jarvis/migration.env; set +a; exec "$1/.venv/bin/alembic" -c "$1/alembic.ini" upgrade head' \
  bash "$release"
sudo -n -u postgres psql -v ON_ERROR_STOP=1 -d jarvis <<'SQL'
GRANT CONNECT ON DATABASE jarvis TO jarvis_backup;
GRANT USAGE ON SCHEMA public TO jarvis_backup;
GRANT SELECT ON TABLE action, memory_log, memory_summary, message TO jarvis_backup;
SQL

if ! sudo test -f /var/lib/jarvis/runtime/paused.json && \
  ! sudo test -f /var/lib/jarvis/runtime/admission.json; then
  sudo -u jarvis bash -c \
    'set -a; source /etc/jarvis/jarvis.env; set +a; exec "$1/.venv/bin/jarvis" initialize-state' \
    bash "$release"
else
  sudo test -f /var/lib/jarvis/runtime/paused.json
  sudo test -f /var/lib/jarvis/runtime/admission.json
fi

sudo -u jarvis bash -c \
  'set -a; source /etc/jarvis/backup-database.env; source /etc/jarvis/backup.env; set +a; exec /usr/bin/restic snapshots --latest 1 >/dev/null' \
  bash

temporary="/opt/jarvis/.current-$commit"
sudo rm -f -- "$temporary"
sudo ln -s "releases/$commit" "$temporary"
sudo mv -Tf "$temporary" /opt/jarvis/current
sudo systemctl enable --now jarvis.service
sudo systemctl enable --now jarvis-backup.timer
sudo systemctl is-active --quiet jarvis.service
sudo systemctl is-active --quiet jarvis-backup.timer
printf 'Activated Jarvis release: %s\n' "$commit"
REMOTE
