# Memory runtime example for local development.
# deploy/install-private-state takes the qualified raw .secrets/jarvis.slice0.env.
JARVIS_DATABASE_URL=postgresql://jarvis_memory:jarvis-memory-dev@127.0.0.1:54328/jarvis
JARVIS_MEMORY_CONFIG_PATH=/etc/jarvis/memory.json
JARVIS_MEMORY_HTTP_PORT=8768
# Dedicated OpenAI project key restricted to the embeddings endpoint.
JARVIS_EMBEDDING_OPENAI_API_KEY=replace-with-embedding-only-openai-project-key
JARVIS_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_EMBEDDING_DIMENSION=1536
