#!/usr/bin/env python3
"""Keep both writers stopped across an ordinary paused schema cut, including reboot."""

import argparse
import json
import os
import subprocess
from pathlib import Path

UNITS = ("jarvis.service", "jarvis-memory.service")
ROOT = Path("/etc/systemd/system")
HOLD = ROOT / "jarvis-cutover.hold"
CONDITION = f"[Unit]\nConditionPathExists=!{HOLD}\n"


def dropin(unit):
    return ROOT / (unit + ".d") / "86-cutover.conf"


def unit_property(unit, name):
    unit_path = unit.replace("-", "_2d").replace(".", "_2e")
    return json.loads(
        subprocess.check_output(
            [
                "busctl",
                "--system",
                "--json=short",
                "get-property",
                "org.freedesktop.systemd1",
                "/org/freedesktop/systemd1/unit/" + unit_path,
                "org.freedesktop.systemd1.Unit",
                name,
            ]
        )
    )["data"]


def require_stopped(unit):
    fields = "LoadState,ActiveState,Result,MainPID,ControlPID,ControlGroup"
    values = dict(
        line.split("=", 1)
        for line in subprocess.check_output(
            ["systemctl", "show", unit, "--property", fields], text=True
        ).splitlines()
    )
    if unit == "jarvis-memory.service" and values["LoadState"] == "not-found":
        return values
    if (
        values["LoadState"] != "loaded"
        or values["ActiveState"] != "inactive"
        or values["Result"] != "success"
        or values["MainPID"] != "0"
        or values["ControlPID"] != "0"
        or unit_property(unit, "Job")[0]
    ):
        raise SystemExit(f"cleanly stop {unit} before the paused cut")
    group = values["ControlGroup"] or f"/system.slice/{unit}"
    directory = Path("/sys/fs/cgroup") / group.lstrip("/")
    if (
        directory.exists()
        and "populated 0" not in (directory / "cgroup.events").read_text().splitlines()
    ):
        raise SystemExit(f"{unit} cgroup still populated")
    return values


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=["stop", "check", "release"])
    parser.add_argument("target")
    args = parser.parse_args()
    if args.operation == "stop":
        for unit in UNITS:
            require_stopped(unit)
        if not HOLD.exists():
            with HOLD.open("x") as stream:
                stream.write(args.target + "\n")
        if HOLD.read_text() != args.target + "\n":
            raise SystemExit("another release holds this cutover")
        for unit in UNITS:
            drop = dropin(unit)
            drop.parent.mkdir(mode=0o755, exist_ok=True)
            if not drop.exists():
                with drop.open("x") as stream:
                    stream.write(CONDITION)
        os.sync()
        subprocess.run(["systemctl", "daemon-reload"], check=True)
    if HOLD.read_text() != args.target + "\n":
        raise SystemExit("cutover hold differs from selected release")
    stopped = {}
    for unit in UNITS:
        drop = dropin(unit)
        if drop.read_text() != CONDITION or any(
            p.stat().st_uid != 0 or p.stat().st_mode & 0o022 for p in (HOLD, drop)
        ):
            raise SystemExit(f"invalid {unit} hold")
        stopped[unit] = require_stopped(unit)
        if stopped[unit]["LoadState"] == "not-found":
            if args.operation == "release":
                raise SystemExit("install memory unit before releasing hold")
            continue
        if not any(
            kind == "ConditionPathExists"
            and not trigger
            and negate
            and path == str(HOLD)
            for kind, trigger, negate, path, result in unit_property(unit, "Conditions")
        ):
            raise SystemExit(f"{unit} hold condition is not loaded")
    print(json.dumps(stopped, sort_keys=True))
    if args.operation == "release":
        for unit in UNITS:
            dropin(unit).unlink()
        HOLD.unlink()
        subprocess.run(["systemctl", "daemon-reload"], check=True)


if __name__ == "__main__":
    main()
