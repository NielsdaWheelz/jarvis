#!/usr/bin/env bash
set -euo pipefail

uv lock --check
uv sync --frozen --all-groups
git diff --check
uv run ruff format --check .
uv run ruff check .
uv run pyright
uv run python scripts/check_docs.py

artifact_directory="$(mktemp -d)"
install_environment="$(mktemp -d)"
trap 'rm -rf -- "$artifact_directory" "$install_environment"' EXIT

uv build --out-dir "$artifact_directory"
wheels=("$artifact_directory"/*.whl)
sdists=("$artifact_directory"/*.tar.gz)
test "${#wheels[@]}" -eq 1
test "${#sdists[@]}" -eq 1
test -f "${wheels[0]}"
test -f "${sdists[0]}"
uv venv --python "$(cat .python-version)" "$install_environment"
uv pip install --python "$install_environment/bin/python" "${wheels[0]}"
"$install_environment/bin/python" -c "import jarvis"
"$install_environment/bin/jarvis" --help >/dev/null
uv run pip-audit --local
echo "static and build checks passed; behavioral verification is suspended (adr 0046)"
