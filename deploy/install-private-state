#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
source_environment="${JARVIS_SOURCE_ENVIRONMENT:-$repo_dir/.secrets/jarvis.slice0.env}"
source_google="${JARVIS_SOURCE_GOOGLE_STATE:-$repo_dir/.secrets/google-connector-state.jarvis.json}"

for path in "$source_environment" "$source_google"; do
  [[ "$path" = /* && -f "$path" && ! -L "$path" ]] || {
    printf 'missing or unsafe private deployment source: %s\n' "$path" >&2
    exit 1
  }
done

scratch="$(mktemp -d "${TMPDIR:-/tmp}/jarvis-private-state.XXXXXX")"
cleanup() {
  case "$scratch" in
  "${TMPDIR:-/tmp}"/jarvis-private-state.*) rm -rf -- "$scratch" ;;
  *) return 1 ;;
  esac
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$scratch"
umask 077

python3 - "$source_environment" "$scratch/jarvis.env" <<'PY'
import pathlib
import re
import sys

source = pathlib.Path(sys.argv[1])
target = pathlib.Path(sys.argv[2])
required = {
    "JARVIS_BRAVE_API_KEY",
    "JARVIS_CONNECTOR_ENCRYPTION_KEY_VERSION",
    "JARVIS_CONNECTOR_ENCRYPTION_SECRET",
    "JARVIS_DISCORD_BOT_TOKEN",
    "JARVIS_DISCORD_CHANNEL_ID",
    "JARVIS_DISCORD_GUILD_ID",
    "JARVIS_DISCORD_OWNER_USER_ID",
    "JARVIS_EMBEDDING_OPENAI_API_KEY",
    "JARVIS_GOOGLE_OAUTH_CLIENT_ID",
    "JARVIS_GOOGLE_OAUTH_CLIENT_SECRET",
    "JARVIS_MAPS_API_KEY",
}
allowed = required | {"JARVIS_GOOGLE_OAUTH_REDIRECT_URI"}
raw = source.read_bytes()
if b"\x00" in raw:
    raise SystemExit("private environment contains a NUL byte")
text = raw.decode("utf-8")
names = []
for line in text.splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    match = re.fullmatch(r"([A-Z][A-Z0-9_]*)=(.*)", line)
    if match is None:
        raise SystemExit("private environment has an unsupported line")
    names.append(match.group(1))
if len(names) != len(set(names)) or set(names) - allowed or required - set(names):
    raise SystemExit("private environment key roster is incompatible")

static = """\
JARVIS_DISCORD_CATCH_UP_LIMIT=100
JARVIS_DISCORD_REQUEST_TIMEOUT_SECONDS=10
JARVIS_DISCORD_DELIVERY_RETRY_DELAYS_SECONDS=0.5,2.0
JARVIS_OWNER_TIMEZONE=America/Los_Angeles
JARVIS_CODEX_PROFILE_KEY=personal
JARVIS_CODEX_MODEL=gpt-5.6-terra
JARVIS_CODEX_HOST_CONFIG_PATH=/etc/codex-shared/profiles.json
JARVIS_HERDR_SSH_CONFIG_PATH=/etc/jarvis-herdr/ssh_config
JARVIS_HERDR_MACHINES=devbox=/home/niels,macbook=/Users/nnandal,arch=/home/nnandal
JARVIS_RUNTIME_STATE_DIRECTORY=/var/lib/jarvis/runtime
JARVIS_GOOGLE_OAUTH_STATE_PATH=/var/lib/jarvis/connectors/google-oauth-state.json
JARVIS_VERIFIED_OWNER_ONLY_CALENDAR_IDS=primary
JARVIS_EMBEDDING_MODEL=text-embedding-3-small
JARVIS_EMBEDDING_DIMENSION=1536
JARVIS_DREAM_INTERVAL_SECONDS=86400
JARVIS_MAXIMUM_BATCH_SIZE=20
JARVIS_DELIVERY_BATCH_SIZE=20
"""
target.write_bytes(raw.rstrip(b"\n") + b"\n" + static.encode("utf-8"))
target.chmod(0o600)
PY

cp -p "$source_google" "$scratch/google-oauth-state.json"
chmod 0600 "$scratch/google-oauth-state.json"

remote="$(ssh "$target" mktemp -d /tmp/jarvis-private-state.XXXXXX)"
case "$remote" in /tmp/jarvis-private-state.*) ;; *) exit 1 ;; esac
scp -q "$scratch/jarvis.env" "$scratch/google-oauth-state.json" \
  "$target:$remote/"

ssh "$target" bash -s -- "$remote" <<'REMOTE'
set -euo pipefail
remote="$1"
case "$remote" in /tmp/jarvis-private-state.*) ;; *) exit 1 ;; esac
cleanup() {
  case "$remote" in /tmp/jarvis-private-state.*) rm -rf -- "$remote" ;; *) return 1 ;; esac
}
trap cleanup EXIT HUP INT TERM

for file in jarvis.env google-oauth-state.json; do
  [[ -f "$remote/$file" && ! -L "$remote/$file" ]]
done
sudo install -d -m 0700 -o jarvis -g jarvis \
  /var/lib/jarvis/connectors
sudo install -m 0600 -o root -g root "$remote/jarvis.env" /etc/jarvis/jarvis.env
sudo install -m 0600 -o jarvis -g jarvis \
  "$remote/google-oauth-state.json" \
  /var/lib/jarvis/connectors/google-oauth-state.json
sudo -u jarvis test -r /etc/codex-shared/profiles.json
printf 'Installed Jarvis application and connector credentials; Codex remains host-owned.\n'
REMOTE
