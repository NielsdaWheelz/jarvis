#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
target="${JARVIS_DEPLOY_TARGET:-dev-server-deploy}"
{
cat "$repo_dir/deploy/agent-client-functions"
cat <<'REMOTE'
set -euo pipefail
[[ "$(systemctl show --property=ProtectHome --value jarvis.service)" == yes ]]
[[ "$(systemctl show --property=NoNewPrivileges --value jarvis.service)" == yes ]]
verify_agent_client /usr/local/libexec/skidbladnir /run/jarvis-skid-state
printf 'jarvis agent client boundary passed; cognition health is checked separately.\n'
REMOTE
} | ssh "$target" sudo bash -s
