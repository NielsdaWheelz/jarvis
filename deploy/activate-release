#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
operation=activate
case "${1:-}" in --prepare|--migrate) operation="${1#--}"; shift ;; esac
if [[ $# != 2 && ( $# != 1 || "$operation" != activate ) ]]; then
  printf 'usage: deploy/activate-release [--prepare|--migrate] [SOURCE_COMMIT] TARGET_COMMIT\n' >&2
  exit 64
fi
commit="${!#}"
receipt_for() {
  local sha="$1" tree lock
  [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || return 1
  tree="$(git -C "$repo_dir" rev-parse --verify "$sha^{tree}")" || return 1
  lock="$(git -C "$repo_dir" show "$sha:uv.lock" | shasum -a 256 | awk '{print $1}')" || return 1
  printf '%s:%s:%s' "$sha" "$tree" "$lock"
}
target_fields="$(receipt_for "$commit")"
source_fields=none
if [[ $# == 2 ]]; then source_fields="$(receipt_for "$1")"; fi

{
cat "$repo_dir/deploy/release-functions"
cat <<'REMOTE'
set -euo pipefail
commit="$1"
release="/opt/jarvis/releases/$commit"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]]

refuse() {
  printf '%s\n' "$1" >&2
  exit 1
}

sudo -n test -f "$release/RELEASE.json" || refuse "release is not installed"
receipt_json() {
  python3 - "$1" <<'PYCODE'
import json, pathlib, sys
commit, tree, lock = sys.argv[1].split(":")
expected = {"commit": commit, "tree": tree, "uv_lock_sha256": lock}
if json.loads((pathlib.Path("/opt/jarvis/releases") / commit / "RELEASE.json").read_bytes()) != expected:
    raise SystemExit("installed receipt differs from externally selected release")
print(json.dumps(expected, separators=(",", ":")))
PYCODE
}
receipt="$(receipt_json "$2")"
source_receipt=none
if [[ "$3" != none ]]; then source_receipt="$(receipt_json "$3")"; fi
operation="$4"
snapshot="/var/lib/jarvis-cutover/adr0087/$commit"
hold=/etc/systemd/system/jarvis-cutover.hold
source="/opt/jarvis/releases/${3%%:*}"
selected=''
if [[ -e /opt/jarvis/current || -L /opt/jarvis/current ]]; then
  selected="$(readlink -e /opt/jarvis/current)"
fi
cutover() {
  systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
    "--property=WorkingDirectory=$release" \
    --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
    --property=EnvironmentFile=/etc/jarvis/migration.env \
    "$release/.venv/bin/python" "$release/deploy/prepare-cutover" "$1" "$snapshot" "$source_receipt" "$receipt" </dev/null
}
if [[ "$operation" == prepare ]]; then
  [[ "$selected" == "$source" ]] || refuse "cut requires the selected 0016 source release"
  if [[ ! -e "$hold" ]]; then
    systemd-run --quiet --wait --pipe --collect --property=Type=oneshot \
      --property=User=jarvis --property=Group=jarvis "--property=WorkingDirectory=$source" \
      --property=EnvironmentFile=/etc/jarvis/database-runtime.env \
      --property=EnvironmentFile=/etc/jarvis/jarvis.env \
      "$source/.venv/bin/jarvis" check-paused </dev/null ||
      refuse "record the ordinary owner pause on the source release before preparing this cut"
  fi
  "$release/deploy/cutover-hold" stop "$commit"
  if [[ -d "$snapshot" ]]; then cutover verify; else cutover snapshot; fi
  exit
fi
if [[ -e "$hold" ]]; then
  [[ "$source_receipt" != none ]] || refuse "supply both selected release commits for the held cut"
  "$release/deploy/cutover-hold" check "$commit"
elif [[ "$source_receipt" != none ]]; then
  refuse "first prepare the stopped schema cut"
else
  for unit in jarvis-memory.service jarvis.service; do
    if [[ -z "$selected" && "$(systemctl show -p LoadState --value "$unit")" == not-found ]]; then continue; fi
    [[ "$(systemctl show -p ActiveState --value "$unit")" == inactive &&
       "$(systemctl show -p Result --value "$unit")" == success &&
       "$(systemctl show -p MainPID --value "$unit")" == 0 ]] || refuse "cleanly stop $unit"
  done
fi

for file in embedding.env database-memory.env memory.env; do
  [[ "$(stat -c '%U:%G:%a' "/etc/jarvis/$file")" == root:root:600 ]] ||
    refuse "provision the protected memory settings before activation"
done
runtime_properties=(
  --property=Type=oneshot --property=User=jarvis --property=Group=jarvis
  "--property=SupplementaryGroups=codex-clients jarvis-memory"
  --property=ProtectHome=true --property=ProtectSystem=strict
  --property=PrivateTmp=true --property=PrivateDevices=true
  --property=NoNewPrivileges=true
  --property=BindsTo=jarvis-codex-contained.service
  --property=After=jarvis-codex-contained.service
  --property=BindReadOnlyPaths=/run/jarvis-contained/exec/app-server.sock:/run/jarvis-contained/app-server.sock
  "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6"
  "--property=ReadWritePaths=/var/lib/jarvis /run/jarvis-codex-cognition /var/cache/jarvis/attachments"
  "--property=WorkingDirectory=$release"
  --property=EnvironmentFile=/etc/jarvis/database-runtime.env
  --property=EnvironmentFile=/etc/jarvis/jarvis.env
)
schema_unit="jarvis-schema-${commit:0:12}-$RANDOM"
schema="$(sudo -n systemd-run --quiet --wait --pipe --collect \
  --unit="$schema_unit" --property=Type=oneshot \
  "--property=WorkingDirectory=$release" \
  --property=EnvironmentFile=/etc/jarvis/migration.env \
  "$release/.venv/bin/python" - <<'PY'
import os

from sqlalchemy import create_engine, text
from sqlalchemy.exc import SQLAlchemyError

from jarvis.db import normalize_database_url
from jarvis.ownership import DEPLOYMENT_LOCK_KEY

try:
    engine = create_engine(normalize_database_url(os.environ["JARVIS_MIGRATION_DATABASE_URL"]))
    with engine.begin() as connection:
        if not connection.scalar(
            text("SELECT pg_try_advisory_xact_lock(:key)"), {"key": DEPLOYMENT_LOCK_KEY}
        ):
            raise SystemExit("schema inspection requires a stopped deployment")
        revision = connection.scalar(text("SELECT version_num FROM alembic_version"))
    engine.dispose()
except (KeyError, SQLAlchemyError, ValueError):
    raise SystemExit("schema inspection failed") from None
print(revision)
PY
)"
if [[ "$operation" == migrate ]]; then
  if [[ "$schema" == 0016 ]]; then cutover migrate; fi
  cutover commit-settings
  cutover verify-target
  exit
fi
[[ "$schema" == 0017 ]] || refuse "commit the paused schema cut before replacing its native host"
if [[ -e "$hold" ]]; then cutover verify-target; fi
[[ "$(stat -c '%U:%G:%a' /run/jarvis-home)" == jarvis:jarvis-home:2750 ]] ||
  refuse "install the private home connector and runtime directory before activation"
if grep -q '^JARVIS_EMBEDDING_' /etc/jarvis/jarvis.env; then
  refuse "finish the postmigration credential handoff before activation"
fi

sudo -n systemctl is-active --quiet jarvis-codex-contained.service ||
  refuse "the separate native host is not active; leave service stopped"
host_check_unit="jarvis-host-check-${commit:0:12}-$RANDOM"
sudo -n systemd-run --quiet --wait --pipe --collect --unit="$host_check_unit" \
  "${runtime_properties[@]}" \
  --property=Environment=JARVIS_CODEX_HOST_CONFIG_PATH=/etc/jarvis/codex-host.json \
  "$release/.venv/bin/python" "$release/deploy/codex-host" verify </dev/null ||
  refuse "the same-release native host did not qualify; leave service stopped"

check_unit="jarvis-check-${commit:0:12}-$RANDOM"
sudo -n systemd-run --quiet --wait --pipe --collect --unit="$check_unit" \
  "${runtime_properties[@]}" "$release/.venv/bin/jarvis" check-activation </dev/null ||
  refuse "activation check failed; leave service stopped"

started=0
stop_failed_activation() {
  status=$?
  if ((status != 0 && started)); then
    sudo -n systemctl stop jarvis.service jarvis-memory.service || true
  fi
  exit "$status"
}
trap stop_failed_activation EXIT
for unit in jarvis.service jarvis-memory.service; do
  sudo -n install -m 0644 -o root -g root "$release/deploy/$unit" "/etc/systemd/system/$unit"
done
sudo -n systemctl daemon-reload
temporary="/opt/jarvis/.current-$commit"
sudo -n rm -f -- "$temporary"
sudo -n ln -s "releases/$commit" "$temporary"
sudo -n mv -Tf "$temporary" /opt/jarvis/current
if [[ -e "$hold" ]]; then "$release/deploy/cutover-hold" release "$commit"; fi
started=1
sudo -n systemctl enable --now jarvis-memory.service jarvis.service
deadline=$((SECONDS + 300))
until sudo -n -u jarvis-tunnel curl --silent --fail --max-time 2 --noproxy '*' \
  --unix-socket /run/jarvis-home/http.sock http://jarvis.nielseriknandal.com/api/home >/dev/null; do
  systemctl is-active --quiet jarvis.service || refuse "assistant stopped before its web listener was ready"
  (( SECONDS < deadline )) || refuse "assistant web listener was unready after five minutes"
  sleep 1
done
for unit in jarvis-memory.service jarvis.service; do
  [[ "$(systemctl show --property=SubState --value "$unit")" == running &&
     "$(systemctl show --property=NRestarts --value "$unit")" == 0 ]] ||
    refuse "$unit did not remain running"
  pid="$(systemctl show -p MainPID --value "$unit")"
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$(readlink -e "/proc/$pid/cwd")" == "$release" ]] ||
    refuse "$unit does not own the selected release"
done
[[ "$(stat -c '%U:%G:%a' /run/jarvis-memory/internal.sock)" == jarvis-memory:jarvis-memory:660 ]] ||
  refuse "private memory socket is missing or incorrectly published"
[[ "$(stat -c '%U:%G:%a' /run/jarvis-home/http.sock)" == jarvis:jarvis-home:660 ]] ||
  refuse "private web socket is missing or incorrectly published"
prune_releases
printf 'activated jarvis release: %s\n' "$commit"
printf 'canonical control was retained; owner chat is on the private web home.\n'
REMOTE
} | ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy \
  sudo -n flock /opt/jarvis/.deploy.lock bash -s -- "$commit" "$target_fields" "$source_fields" "$operation"
