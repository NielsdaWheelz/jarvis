#!/usr/bin/env python3
"""Systemd entry points for the separate, contained personal Codex host."""

from __future__ import annotations

import asyncio
import grp
import json
import os
import pwd
import stat
import subprocess
import sys
from pathlib import Path

from provider_runtime.agent_runtime import (
    CODEX_CONTAINMENT_VERSION,
    materialize_codex_containment_catalog,
    qualify_codex_containment_host,
)

from jarvis.codex_config import CodexHostConfig


def _host_identity(config: CodexHostConfig) -> None:
    if (
        os.geteuid() != pwd.getpwnam(config.development_user).pw_uid
        or os.getegid() != grp.getgrnam(config.client_group).gr_gid
    ):
        raise RuntimeError("contained host must use its configured host identity/group")


def remove_alias(config: CodexHostConfig) -> None:
    alias = config.endpoints["personal"]
    try:
        metadata = alias.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISLNK(metadata.st_mode):
        raise RuntimeError("contained host rendezvous must be its socket alias")
    alias.unlink()


def start(config: CodexHostConfig) -> None:
    _host_identity(config)
    alias = config.endpoints["personal"]
    directory = alias.parent
    metadata = directory.stat()
    if (
        metadata.st_uid != os.geteuid()
        or metadata.st_gid != os.getegid()
        or stat.S_IMODE(metadata.st_mode) not in (0o700, 0o710)
    ):
        raise RuntimeError(
            "contained host socket directory has the wrong ownership/mode"
        )
    directory.chmod(0o700)
    remove_alias(config)
    catalog = materialize_codex_containment_catalog(directory)
    environment = {
        "CODEX_HOME": config.profiles["personal"].account_home,
        "CODEX_EXEC_SERVER_URL": "none",
        "HOME": pwd.getpwuid(os.geteuid()).pw_dir,
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }
    version = subprocess.run(
        [config.binary, "--version"],
        env=environment,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=5,
    ).stdout.strip()
    if version != f"codex-cli {CODEX_CONTAINMENT_VERSION}":
        raise RuntimeError(
            "contained host binary differs from the qualified native version"
        )
    os.execve(
        config.binary,
        [
            config.binary,
            "-c",
            f"model_catalog_json={json.dumps(str(catalog))}",
            "app-server",
            "--listen",
            f"unix://{alias}",
            "--strict-config",
        ],
        environment,
    )


async def publish(config: CodexHostConfig) -> None:
    _host_identity(config)
    alias = config.endpoints["personal"]
    directory = alias.parent
    async with asyncio.timeout(15):
        for _ in range(300):
            if alias.is_symlink() and alias.resolve().is_socket():
                break
            await asyncio.sleep(0.05)
        else:
            raise TimeoutError("contained host native socket did not become ready")
        target = alias.resolve()
        metadata = target.stat()
        if (
            not target.parent.samefile(directory)
            or metadata.st_uid != os.geteuid()
            or metadata.st_gid != os.getegid()
            or stat.S_IMODE(directory.stat().st_mode) != 0o700
        ):
            raise RuntimeError("native socket escaped the contained host directory")
        await qualify_codex_containment_host(target)
        target.chmod(0o660)
        directory.chmod(0o710)
        alias.unlink()
        alias.symlink_to(target.name)


async def verify(config: CodexHostConfig) -> None:
    alias = config.endpoints["personal"]
    directory = alias.parent
    host_uid = pwd.getpwnam(config.development_user).pw_uid
    client_gid = grp.getgrnam(config.client_group).gr_gid
    metadata = alias.stat()
    parent = directory.stat()
    if (
        not alias.is_symlink()
        or os.readlink(alias) != alias.resolve().name
        or not stat.S_ISSOCK(metadata.st_mode)
        or metadata.st_uid != host_uid
        or metadata.st_gid != client_gid
        or stat.S_IMODE(metadata.st_mode) != 0o660
        or parent.st_uid != host_uid
        or parent.st_gid != client_gid
        or stat.S_IMODE(parent.st_mode) != 0o710
    ):
        raise RuntimeError(
            "contained host socket is not published to the configured group"
        )
    if not os.access(alias, os.W_OK) or os.access(
        Path(config.profiles["personal"].account_home) / "auth.json", os.R_OK
    ):
        raise RuntimeError(
            "application needs socket access without account credentials"
        )
    await qualify_codex_containment_host(alias)


def verify_release() -> None:
    release = Path(__file__).resolve().parent.parent
    response = subprocess.run(
        [
            "busctl",
            "--json=short",
            "get-property",
            "org.freedesktop.systemd1",
            "/org/freedesktop/systemd1/unit/jarvis_2dcodex_2dcontained_2eservice",
            "org.freedesktop.systemd1.Service",
            "ExecStart",
        ],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=5,
    )
    value = json.loads(response.stdout)
    if value.get("type") != "a(sasbttttuii)":
        raise RuntimeError("systemd returned an unsupported ExecStart property")
    data = value["data"]
    executable = str(release / ".venv/bin/python")
    argv = [executable, str(release / "deploy/codex-host"), "start"]
    if len(data) != 1 or data[0][:2] != [executable, argv]:
        raise RuntimeError("contained host unit does not select this immutable release")


if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in (
        "start",
        "publish",
        "verify",
        "cleanup",
    ):
        raise SystemExit("usage: codex-host start|publish|verify|cleanup")
    mapping = Path(
        os.environ.get("JARVIS_CODEX_HOST_CONFIG_PATH", "/etc/jarvis/codex-host.json")
    )
    config = CodexHostConfig.load(mapping)
    match sys.argv[1]:
        case "start":
            start(config)
        case "publish":
            asyncio.run(publish(config))
        case "verify":
            verify_release()
            asyncio.run(verify(config))
        case "cleanup":
            remove_alias(config)
