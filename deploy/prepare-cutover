def require(condition, reason):
    if not condition:
        raise RuntimeError(reason)


def file_digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def copy_digest(root, *, excluded=None):
    digest = hashlib.sha256()
    for path in [root, *sorted(root.rglob("*"))]:
        if excluded is not None and path.is_relative_to(excluded):
            continue
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode):
            content = os.readlink(path)
        elif stat.S_ISREG(info.st_mode):
            content = file_digest(path)
        elif stat.S_ISDIR(info.st_mode):
            content = None
        else:
            raise RuntimeError("unsupported recovery file type")
        entry = [
            str(path.relative_to(root)),
            info.st_mode,
            info.st_uid,
            info.st_gid,
            content,
        ]
        digest.update(json.dumps(entry, ensure_ascii=True).encode() + b"\n")
    return digest.hexdigest()


def json_digest(value):
    return hashlib.sha256(
        json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


async def inventory(conn, scope):
    await conn.execute(text("SET LOCAL TIME ZONE 'UTC'"))
    await conn.execute(text("SET LOCAL DateStyle TO 'ISO, YMD'"))
    await conn.execute(text("SET LOCAL IntervalStyle TO postgres"))
    await conn.execute(text("SET LOCAL extra_float_digits TO 3"))
    await conn.execute(text("SET LOCAL bytea_output TO hex"))
    control = (
        (
            await conn.execute(
                text("""
        SELECT id::text AS id, control_kind AS kind, control_sequence AS sequence,
            to_json(control_targets) AS targets
        FROM message WHERE source_conversation_id=:scope AND control_kind IS NOT NULL
        ORDER BY control_sequence DESC LIMIT 1
    """),
                {"scope": scope},
            )
        )
        .mappings()
        .one_or_none()
    )
    require(
        control is not None and control["kind"] in {"pause", "resume"},
        "stopped snapshot requires initialized owner control",
    )
    tables = (
        (
            await conn.execute(
                text("""
        SELECT format('%I.%I', nspname, relname)
        FROM pg_class JOIN pg_namespace n ON relnamespace=n.oid
        WHERE nspname='public' AND relkind='r' ORDER BY relname COLLATE "C"
    """)
            )
        )
        .scalars()
        .all()
    )
    # Sorting fixed-size hashes compares complete multisets, including a new table
    # whose key definition did not exist in the source release.
    rows = {table: await row_inventory(conn, table, "1") for table in tables}
    sequences = (
        (
            await conn.execute(
                text("""
        SELECT format('%I.%I', nspname, relname)
        FROM pg_class JOIN pg_namespace n ON relnamespace=n.oid
        WHERE nspname='public' AND relkind='S' ORDER BY relname COLLATE "C"
    """)
            )
        )
        .scalars()
        .all()
    )
    cursors = {
        seq: list(
            (await conn.execute(text(f"SELECT last_value,is_called FROM {seq}"))).one()
        )
        for seq in sequences
    }
    roles = {"roles": list(RESTORE_ROLES)}
    privileges = [
        list(row)
        for row in await conn.execute(
            text("""
        SELECT rolname,rolcanlogin,rolsuper,rolcreaterole,rolcreatedb,
               rolreplication,rolbypassrls,rolinherit,rolconnlimit,rolvaliduntil::text
        FROM pg_roles WHERE rolname=ANY(:roles) ORDER BY rolname
    """),
            roles,
        )
    ]
    members = [
        list(row)
        for row in await conn.execute(
            text("""
        SELECT pg_get_userbyid(roleid),pg_get_userbyid(member),pg_get_userbyid(grantor),
               admin_option,inherit_option,set_option
        FROM pg_auth_members
        WHERE pg_get_userbyid(roleid)=ANY(:roles) OR pg_get_userbyid(member)=ANY(:roles)
        ORDER BY 1,2,3
    """),
            roles,
        )
    ]
    return {
        "tables": rows,
        "sequences": cursors,
        "database": await database_identity(conn),
        "roles": privileges,
        "memberships": members,
        "schema": await schema_inventory(conn),
        "control": dict(control),
    }


async def require_phone_cut(conn, facts, original):
    require(
        {k: v for k, v in facts.items() if k not in {"tables", "schema"}}
        == {k: v for k, v in original.items() if k not in {"tables", "schema"}},
        "phone cut changed database identity, grants, sequences, or canonical control",
    )
    changed = {"public.alembic_version", "public.home_notice"}
    require(
        {k: v for k, v in facts["tables"].items() if k not in changed}
        == {k: v for k, v in original["tables"].items() if k not in changed}
        and await row_inventory(
            conn,
            """(SELECT id,kind,message_id,action_id,created_at,
                       provider_id AS discord_message_id FROM public.home_notice)""",
            "1",
        )
        == original["tables"]["public.home_notice"],
        "phone cut changed existing rows or notice delivery identities",
    )
    require(
        await conn.scalar(
            text("""
            SELECT EXISTS(SELECT FROM pg_constraint
                WHERE conrelid='home_notice'::regclass
                  AND conname='ck_home_notice_provider' AND convalidated)
            AND EXISTS(SELECT FROM pg_indexes WHERE schemaname='public'
                AND indexname='ix_home_notice_pending'
                AND indexdef LIKE '%WHERE (provider_id IS NULL)')
            AND has_column_privilege(
                'jarvis_runtime', 'home_notice', 'provider', 'UPDATE')
            AND has_column_privilege(
                'jarvis_runtime', 'home_notice', 'provider_id', 'UPDATE')
            AND NOT has_column_privilege(
                'jarvis_runtime', 'home_notice', 'kind', 'UPDATE')
            AND NOT EXISTS(SELECT FROM home_notice
                WHERE (provider_id IS NOT NULL AND provider IS DISTINCT FROM 'discord')
                   OR (provider_id IS NULL AND kind <> 'reply'))
        """)
        ),
        "converted notice provider, pending rows or grants differ from the stopped cut",
    )


async def workspace_obligations(conn, state):
    """Inventory exact stopped predecessor obligations without entering an executor."""
    rows = await conn.execute(
        text("""
        SELECT 'action' AS kind, id::text AS id, tool_name AS operation, status
        FROM action
        WHERE status IN ('queued','awaiting_approval','executing','uncertain')
          AND (tool_name LIKE 'gmail.%' OR tool_name LIKE 'calendar.%'
               OR tool_name IN ('events.configure','attachment.retain'))
        UNION ALL
        SELECT 'paid_read', position, contract->>'tool_id', state
        FROM read_position
        WHERE state <> 'completed' AND contract->>'replay_policy' = 'BilledOnce'
          AND (contract->>'tool_id' LIKE 'gmail.%'
               OR contract->>'tool_id' LIKE 'calendar.%'
               OR contract->>'tool_id' IN ('attachment.retain','events.status'))
        UNION ALL
        SELECT 'attempt', id::text, 'native', 'unsealed' FROM native_attempt
        WHERE product_outcome IS NULL AND
              (fenced_at IS NULL OR recovery_pending OR terminal_at IS NOT NULL)
        UNION ALL
        SELECT 'import', id::text, 'attachment.retain', state FROM attachment
        WHERE source->>'kind'='gmail' AND state='pending'
        ORDER BY 1,2
    """)
    )
    obligations = [dict(row) for row in rows.mappings()]
    if any(
        r["operation"] == "gmail.send_draft" and r["status"] == "uncertain"
        for r in obligations
    ):
        # This only accepts the predecessor's inventory-bound, send-specific
        # receipt. No live reconcilers are part of the successor.
        from jarvis.gmail_cut import CUT_RECEIPT, verified_cut_ids

        history = (
            (
                await conn.execute(
                    text("""
            SELECT id,tool_name,status,attempts,arguments,result FROM action
            WHERE tool_name IN ('gmail.create_draft','gmail.update_draft',
                                'gmail.send_draft')
              AND NOT (execution_contract ? 'mail') ORDER BY created_at,id
        """)
                )
            )
            .mappings()
            .all()
        )
        known = verified_cut_ids(history, state / "runtime" / CUT_RECEIPT) or ()
        settled = {str(identifier) for identifier in known}
        obligations = [
            r
            for r in obligations
            if not (
                r["kind"] == "action"
                and r["operation"] == "gmail.send_draft"
                and r["status"] == "uncertain"
                and r["id"] in settled
            )
        ]
    stage = state / "mail-stage"
    if stage.exists():
        obligations.extend(
            {
                "kind": "stage",
                "id": entry.name,
                "operation": "gmail",
                "status": "staged",
            }
            for entry in sorted(stage.iterdir())
        )
    return obligations


def require_clear_workspace(obligations):
    require(
        not obligations,
        "workspace cut held for predecessor disposition: "
        + json.dumps(obligations, ensure_ascii=True, separators=(",", ":")),
    )


async def require_workspace_target(conn, facts, original):
    changed = {"public.alembic_version", "public.work", "public.gmail_usage"}
    require(
        {k: v for k, v in facts.items() if k not in {"schema", "tables"}}
        == {k: v for k, v in original.items() if k not in {"schema", "tables"}}
        and {k: v for k, v in facts["tables"].items() if k not in changed}
        == {k: v for k, v in original["tables"].items() if k not in changed}
        and facts["tables"]["public.gmail_usage"][0] == 0
        and not await conn.scalar(
            text("SELECT EXISTS(SELECT FROM work WHERE workspace_check IS NOT NULL)")
        )
        and await row_inventory(
            conn,
            """(SELECT id,title,state,content,due_date,wake_id,
                wake_at,repeat,wake_local_date,created_at,updated_at
                FROM public.work)""",
            "1",
        )
        == original["tables"]["public.work"],
        "workspace cut altered predecessor rows, authority, control or usage baseline",
    )


def write_snapshot(destination, evidence, system_stop, args, sql_snapshot):
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    require(not destination.exists(), "snapshot exists; verify it or inspect it")
    stage = Path(tempfile.mkdtemp(prefix=".incomplete-", dir=destination.parent))
    try:
        dump = stage / "database.dump"
        with dump.open("xb") as out:
            subprocess.run(
                [POSTGRES_BIN / "pg_dump", "-Fc", "--snapshot", sql_snapshot],
                stdout=out,
                **args,
            )
        subprocess.run(
            [POSTGRES_BIN / "pg_restore", "--file=/dev/null", str(dump)], **args
        )
        copies = {}
        for name, path in (
            ("private-state", STATE),
            ("declarations", DECLARATIONS),
        ):
            target = stage / name
            excluded = path / "phone" if path == STATE else None
            if excluded is None:
                subprocess.run(["cp", "-a", "--", str(path), str(target)], check=True)
            else:
                info = path.stat()
                target.mkdir()
                os.chown(target, info.st_uid, info.st_gid)
                target.chmod(stat.S_IMODE(info.st_mode))
                for entry in path.iterdir():
                    if entry != excluded:
                        subprocess.run(
                            ["cp", "-a", "--", str(entry), str(target)], check=True
                        )
            copies[name] = copy_digest(target)
            require(
                copies[name] == copy_digest(path, excluded=excluded),
                "private copy mismatch",
            )
        replace_private_json(
            stage / "SNAPSHOT.json",
            {
                **evidence,
                "copies": copies,
                "dump_sha256": file_digest(dump),
                "system_stop": system_stop,
            },
        )
        os.sync()
        stage.rename(destination)
        os.sync()
    finally:
        if stage.exists():
            shutil.rmtree(stage)


def check_qualification(document, manifest):
    expected = rehearsal_binding(manifest)
    require(
        all(document.get(k) == v for k, v in expected.items()),
        "rehearsal differs from the selected releases or stopped dump",
    )
    report = document.get("compatibility", {})
    require(
        report.get("outcome") == "compatible"
        and report.get("control") == manifest["original_facts"]["control"]
        and isinstance(report.get("findings"), list)
        and all(f.get("verdict") == "compatible" for f in report["findings"]),
        "candidate rehearsal has no compatible stopped verdict",
    )
    require(
        isinstance(document.get("target_facts_sha256"), str)
        and len(document["target_facts_sha256"]) == 64,
        "candidate rehearsal lacks target inventory",
    )


def rehearsal_binding(manifest):
    return {
        "format": "jarvis-migration-rehearsal.v1",
        "change": manifest["change"],
        "source": manifest["source"],
        "target": manifest["target"],
        "dump_sha256": manifest["dump_sha256"],
        "copies": manifest["copies"],
        "source_facts_sha256": json_digest(manifest["original_facts"]),
    }


def check_private_inputs(snapshot, manifest):
    require(
        all(
            copy_digest(snapshot / name) == manifest["copies"][name]
            for name in ("private-state", "declarations")
        ),
        "damaged private recovery copy",
    )
    google = Path("connectors/google-oauth-state.json")
    require(
        all(
            copy_digest(DECLARATIONS / name)
            == copy_digest(snapshot / "declarations" / name)
            for name in ("jarvis.env", "memory.json", "codex-host.json")
        )
        and (
            (
                not (STATE / google).exists()
                and not (snapshot / "private-state" / google).exists()
            )
            or (
                (STATE / google).is_file()
                and (snapshot / "private-state" / google).is_file()
                and copy_digest(STATE / google)
                == copy_digest(snapshot / "private-state" / google)
            )
        ),
        "authority differs from the stopped declarations or google state",
    )
    if (manifest["source"]["schema"], manifest["target"]["schema"]) == ("0022", "0023"):
        sender = Path("connectors/fcm-sender.json")
        require(
            copy_digest(DECLARATIONS / "fcm.env")
            == copy_digest(snapshot / "declarations/fcm.env")
            and copy_digest(STATE / sender)
            == copy_digest(snapshot / "private-state" / sender),
            "firebase authority differs from the stopped copy",
        )


def restored_compatibility(proof):
    release = Path(__file__).resolve().parents[1]
    runtime_url = os.environ["JARVIS_DATABASE_URL"]
    urls = [
        make_url(normalize_database_url(os.environ[name]))
        for name in ("JARVIS_DATABASE_URL", "JARVIS_MIGRATION_DATABASE_URL")
    ]
    require(
        urls[0].username == "jarvis_runtime"
        and urls[1].username == "jarvis_migrator"
        and (urls[0].host, urls[0].port or 5432, urls[0].database)
        == (urls[1].host, urls[1].port or 5432, urls[1].database)
        and urls[0].host
        and urls[0].database
        and not any(c.isspace() or ord(c) in (34, 39, 92) for c in runtime_url),
        "invalid rehearsal runtime and migration endpoints",
    )
    with tempfile.TemporaryDirectory(dir=proof) as scratch:
        root = Path(scratch)
        (root / "runtime.env").write_text(
            "JARVIS_DATABASE_URL=" + runtime_url + "\nJARVIS_WORKSPACE_PROJECT_ID=\n"
        )
        (root / "input.json").write_text('{"authority_changes":[]}')
        subprocess.run(
            [
                "bash",
                "-c",
                'source "$1/deploy/release-functions"; '
                "unset MAINTENANCE_GOOGLE_STATE MAINTENANCE_MEMORY_CONFIG; "
                'check_maintenance "$1" "$2/input.json" "$2/result.json" '
                '"$2/runtime.env"',
                "rehearsal",
                release,
                root,
            ],
            check=True,
        )
        return json.loads((root / "result.json").read_bytes())


async def inspect_restored(operation, snapshot, proof, map_sha256=None):
    editor = owner_gmail_directory(OWNER_GMAIL_DIRECTORY)
    require(
        read_editor_stamp(editor) is None,
        "invalidate the owner gmail editor before opening restored state",
    )
    manifest = json.loads((snapshot / "SNAPSHOT.json").read_bytes())
    require(
        file_digest(snapshot / "database.dump") == manifest["dump_sha256"],
        "damaged rehearsal dump",
    )
    check_private_inputs(snapshot, manifest)
    target = manifest["target"]
    require(
        target["schema"] == APPLICATION_SCHEMA_REVISION
        and json.loads(
            (Path(__file__).resolve().parents[1] / "RELEASE.json").read_bytes()
        )
        == {k: v for k, v in target.items() if k != "schema"},
        "wrong rehearsal target release",
    )
    migration_url = normalize_database_url(os.environ["JARVIS_MIGRATION_DATABASE_URL"])
    migrating_drive = operation == "migrate-restored-drive"
    original = rehearsal_binding(manifest)
    source_proof = proof / "restored-source.json"
    if migrating_drive:
        url = make_url(migration_url)
        require(
            target["schema"] == DRIVE_CUSTODY_SCHEMA
            and [url.host, url.port or 5432, url.database] != manifest["database"]
            and json.loads(source_proof.read_bytes()) == original,
            "drive rehearsal requires a verified, separate restored database",
        )
        drive_map = proof / "drive-cut.json"
        require(
            file_digest(drive_map) == map_sha256,
            "drive attachment map differs from the approved digest",
        )
        verified_map = load_stopped_drive_map(
            drive_map,
            spool=snapshot / "private-state" / "runtime" / "uploads",
            google_state=snapshot
            / "private-state"
            / "connectors"
            / "google-oauth-state.json",
        )
    engine = create_engine(migration_url)
    try:
        async with maintenance_ownership(engine) as db, db.begin() as conn:
            mode = "READ WRITE" if migrating_drive else "READ ONLY"
            await conn.execute(
                text(f"SET TRANSACTION ISOLATION LEVEL REPEATABLE READ, {mode}")
            )
            version = await conn.scalar(text("SELECT version_num FROM alembic_version"))
            facts = await inventory(conn, manifest["owner_scope"])
            if migrating_drive:
                require(
                    version == manifest["source"]["schema"]
                    and facts == manifest["original_facts"],
                    "restored source differs from the stopped database",
                )

                def upgrade(connection):
                    cfg = Config(
                        str(Path(__file__).resolve().parents[1] / "alembic.ini")
                    )
                    cfg.attributes["connection"] = connection
                    cfg.attributes["drive_cut"] = verified_map.model_dump(mode="json")
                    command.upgrade(cfg, target["schema"])

                await conn.run_sync(upgrade)
                require(
                    await conn.scalar(text("SELECT version_num FROM alembic_version"))
                    == target["schema"],
                    "drive rehearsal did not reach the target schema",
                )
                return
            if (manifest["source"]["schema"], target["schema"]) == ("0023", "0024"):
                if version == "0023":
                    observed = await workspace_obligations(
                        conn, snapshot / "private-state"
                    )
                    require(
                        observed == manifest.get("workspace_obligations"),
                        "restored workspace obligations differ from the stopped source",
                    )
                    require_clear_workspace(observed)
                elif version == "0024":
                    await require_workspace_target(
                        conn, facts, manifest["original_facts"]
                    )
            if operation == "record-rehearsal" and (
                manifest["source"]["schema"],
                version,
            ) == ("0022", "0023"):
                await require_phone_cut(conn, facts, manifest["original_facts"])
        proof.mkdir(mode=0o700, exist_ok=True)
        if operation == "verify-restored-source":
            require(
                version == manifest["source"]["schema"]
                and facts == manifest["original_facts"],
                "restored source differs from the stopped database",
            )
            replace_private_json(source_proof, original)
            return
        require(
            version == target["schema"]
            and facts["control"] == manifest["original_facts"]["control"]
            and json.loads(source_proof.read_bytes()) == original,
            "restored target or control differs",
        )
        document = {
            **original,
            "target_facts_sha256": json_digest(facts),
            "compatibility": restored_compatibility(proof),
        }
        if version == DRIVE_CUSTODY_SCHEMA:
            drive_map = proof / "drive-cut.json"
            load_stopped_drive_map(
                drive_map,
                spool=snapshot / "private-state" / "runtime" / "uploads",
                google_state=snapshot
                / "private-state"
                / "connectors"
                / "google-oauth-state.json",
            )
            document["drive_map_sha256"] = file_digest(drive_map)
        check_qualification(document, manifest)
        replace_private_json(proof / "qualification.json", document)
    finally:
        await engine.dispose()


async def cut(operation, destination, binding, stop, qualification):
    runtime = make_url(normalize_database_url(os.environ["JARVIS_DATABASE_URL"]))
    migration_url = normalize_database_url(os.environ["JARVIS_MIGRATION_DATABASE_URL"])
    migrator = make_url(migration_url)
    endpoint = [runtime.host, runtime.port or 5432, runtime.database]
    require(
        endpoint == [migrator.host, migrator.port or 5432, migrator.database]
        and migrator.host
        and migrator.database,
        "migration and runtime database endpoints differ",
    )
    scopes = [
        row.partition(b"=")[2].decode("ascii")
        for row in (DECLARATIONS / "jarvis.env").read_bytes().splitlines()
        if row.partition(b"=")[0] == b"JARVIS_OWNER_SCOPE"
    ]
    require(len(scopes) == 1 and scopes[0].isdigit(), "invalid installed owner scope")
    scope = scopes[0]
    os.environ["JARVIS_OWNER_SCOPE"] = scope
    source, target = binding["source"], binding["target"]
    for identity in (source, target):
        actual = json.loads(
            (ROOT / "releases" / identity["commit"] / "RELEASE.json").read_bytes()
        )
        require(
            actual == {k: v for k, v in identity.items() if k != "schema"},
            "release receipt mismatch",
        )
    target_dir = ROOT / "releases" / target["commit"]
    allowed = {ROOT / "releases" / source["commit"]}
    if operation in {"migrate", "verify-target"}:
        allowed.add(target_dir)
    selected = (ROOT / "current").resolve(strict=True)
    require(
        selected in allowed
        and Path(__file__).resolve().parents[1] == target_dir
        and APPLICATION_SCHEMA_REVISION == target["schema"],
        "selected release or target differs",
    )
    engine = create_engine(migration_url)
    try:
        async with maintenance_ownership(engine) as db, db.begin() as conn:
            await conn.execute(text("SET TRANSACTION ISOLATION LEVEL REPEATABLE READ"))
            version = await conn.scalar(text("SELECT version_num FROM alembic_version"))
            allowed = {source["schema"]}
            if operation in {"migrate", "verify-target"}:
                allowed = (
                    {target["schema"]}
                    if selected == target_dir or operation == "verify-target"
                    else {source["schema"], target["schema"]}
                )
            require(version in allowed, "unexpected stopped schema")
            facts = await inventory(conn, scope)
            evidence = {
                "format": "jarvis-stopped-snapshot.v1",
                "change": binding["id"],
                "source": source,
                "target": target,
                "owner_scope": scope,
                "database": endpoint,
            }
            workspace_cut = (source["schema"], target["schema"]) == ("0023", "0024")
            if workspace_cut and version == "0023":
                evidence["workspace_obligations"] = await workspace_obligations(
                    conn, STATE
                )
            if operation == "snapshot" and not destination.exists():
                require(
                    not (destination.parent / "applying").exists(),
                    "mutation may have begun before snapshot",
                )
                snapshot_id = await conn.scalar(text("SELECT pg_export_snapshot()"))
                write_snapshot(
                    destination,
                    {**evidence, "original_facts": facts},
                    stop,
                    {
                        "env": pg_environment(migrator),
                        "check": True,
                        "stderr": subprocess.DEVNULL,
                    },
                    snapshot_id,
                )
                if workspace_cut:
                    require_clear_workspace(evidence["workspace_obligations"])
                return
            manifest = json.loads((destination / "SNAPSHOT.json").read_bytes())
            require(
                all(manifest.get(k) == v for k, v in evidence.items()),
                "snapshot belongs to a different change",
            )
            require(
                file_digest(destination / "database.dump") == manifest["dump_sha256"],
                "damaged stopped recovery copy",
            )
            check_private_inputs(destination, manifest)
            if version == source["schema"]:
                require(
                    facts == manifest["original_facts"], "stopped source facts changed"
                )
            if workspace_cut:
                require_clear_workspace(manifest["workspace_obligations"])
            if operation in {"snapshot", "verify"}:
                return
            document = json.loads(qualification.read_bytes())
            check_qualification(document, manifest)
            verified_drive_map = None
            if target["schema"] == DRIVE_CUSTODY_SCHEMA:
                drive_map = qualification.with_name("drive-cut.json")
                require(
                    file_digest(drive_map) == document.get("drive_map_sha256"),
                    "drive attachment map differs from rehearsal",
                )
                verified_drive_map = load_stopped_drive_map(
                    drive_map,
                    spool=destination / "private-state" / "runtime" / "uploads",
                    google_state=destination
                    / "private-state"
                    / "connectors"
                    / "google-oauth-state.json",
                )
            if operation == "verify-rehearsal":
                return
            require(
                (destination.parent / "applying").exists(),
                "mutation requires an applying hold",
            )
            if operation == "migrate" and version == source["schema"]:

                def upgrade(connection):
                    cfg = Config(str(target_dir / "alembic.ini"))
                    cfg.attributes["connection"] = connection
                    if verified_drive_map is not None:
                        cfg.attributes["drive_cut"] = verified_drive_map.model_dump(
                            mode="json"
                        )
                    command.upgrade(cfg, target["schema"])

                await conn.run_sync(upgrade)
                facts = await inventory(conn, scope)
            if workspace_cut:
                await require_workspace_target(conn, facts, manifest["original_facts"])
            if (source["schema"], target["schema"]) == ("0022", "0023"):
                await require_phone_cut(conn, facts, manifest["original_facts"])
            require(
                await conn.scalar(text("SELECT version_num FROM alembic_version"))
                == target["schema"]
                and json_digest(facts) == document["target_facts_sha256"]
                and facts["control"] == manifest["original_facts"]["control"],
                "production migration differs from the qualified target",
            )
    finally:
        await engine.dispose()


def main():
    os.umask(0o077)
    if len(sys.argv) >= 2 and sys.argv[1] in {
        "verify-restored-source",
        "migrate-restored-drive",
        "record-rehearsal",
    }:
        parser = argparse.ArgumentParser(
            description="Observe an isolated restored migration rehearsal."
        )
        parser.add_argument("operation")
        parser.add_argument("snapshot", type=Path)
        parser.add_argument("proof", type=Path)
        parser.add_argument("--map-sha256")
        args = parser.parse_args()
        require(
            (args.operation == "migrate-restored-drive")
            == (args.map_sha256 is not None),
            "the restored drive migration requires its approved map digest",
        )
        asyncio.run(
            inspect_restored(
                args.operation,
                args.snapshot.resolve(),
                args.proof.resolve(),
                args.map_sha256,
            )
        )
        return
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "operation",
        choices=["snapshot", "verify", "verify-rehearsal", "migrate", "verify-target"],
    )
    parser.add_argument("change")
    parser.add_argument("source")
    parser.add_argument("target")
    parser.add_argument("source_schema")
    parser.add_argument("target_schema")
    parser.add_argument("qualification", type=Path, nargs="?")
    args = parser.parse_args()
    subprocess.run(
        [Path(__file__).with_name("cutover-hold"), "check", args.change], check=True
    )
    held = Path("/var/lib/jarvis-cutover/held")
    stop = json.loads((held / "receipt.json").read_bytes())
    binding = stop["binding"]
    require(
        binding["id"] == args.change
        and binding["operation"] == "release"
        and {"jarvis.service", "jarvis-memory.service"} <= set(binding["units"])
        and (
            binding["source"]["commit"],
            binding["target"]["commit"],
            binding["source"]["schema"],
            binding["target"]["schema"],
        )
        == (args.source, args.target, args.source_schema, args.target_schema)
        and args.source_schema != args.target_schema,
        "schema transition differs from the active release hold",
    )
    require(
        (args.operation not in {"snapshot", "verify"})
        == (args.qualification is not None),
        "qualified migration input is required",
    )
    asyncio.run(
        cut(args.operation, held / "snapshot", binding, stop, args.qualification)
    )
    print(
        f"{args.operation} verified for {args.change}. "
        f"stopped copy: {held / 'snapshot'}"
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(
            str(error) if type(error) is RuntimeError else type(error).__name__,
            file=sys.stderr,
        )
        sys.exit(1)
