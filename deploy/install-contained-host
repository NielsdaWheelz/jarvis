#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == --held && $# == 4 && $EUID == 0 ]]; then
  change="$2"
  commit="$3"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]]
  remote="$(mktemp -d /tmp/jarvis-contained-host.XXXXXX)"
  trap 'rm -rf -- "$remote"' EXIT
  install -m 0644 -- "$4" "$remote/codex-host.json"
elif [[ "${1:-}" == --bootstrap-on-host && $# == 3 && $EUID == 0 ]]; then
  change=bootstrap
  commit="$2"
  remote="$3"
  [[ "$commit" =~ ^[0-9a-f]{40}$ && "$remote" =~ ^/tmp/jarvis-contained-host\.[a-zA-Z0-9]+$ ]]
else
  commit="${1:-}"
  source_mapping="${JARVIS_SOURCE_CODEX_HOST_CONFIG:?supply the provisioned non-secret contained account mapping}"
  if [[ ! "$commit" =~ ^[0-9a-f]{40}$ ]] || (($# != 1)); then
    printf 'usage for virgin bootstrap: deploy/install-contained-host FULL_GIT_COMMIT\n' >&2
    exit 64
  fi
  [[ "$source_mapping" = /* && -f "$source_mapping" && ! -L "$source_mapping" ]]
  remote="$(ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy mktemp -d /tmp/jarvis-contained-host.XXXXXX)"
  [[ "$remote" =~ ^/tmp/jarvis-contained-host\.[a-zA-Z0-9]+$ ]]
  scp -q -o BatchMode=yes -o ForwardAgent=no "$source_mapping" "dev-server-deploy:$remote/codex-host.json"
  exec ssh -T -o BatchMode=yes -o ForwardAgent=no dev-server-deploy \
    sudo -n flock /opt/jarvis/.deploy.lock \
    "/opt/jarvis/releases/$commit/deploy/install-contained-host" --bootstrap-on-host "$commit" "$remote"
fi
probe_file=
cleanup() {
  if [[ -n "$probe_file" ]]; then rm -f -- "$probe_file"; fi
  rm -rf -- "$remote"
}
trap cleanup EXIT HUP INT TERM
release="/opt/jarvis/releases/$commit"
source "$release/deploy/release-functions"
sudo -n test -f "$release/RELEASE.json"
[[ -f "$remote/codex-host.json" && ! -L "$remote/codex-host.json" ]]

if [[ "$change" == bootstrap ]]; then
  require_no_cutover_hold
  [[ ! -e /opt/jarvis/current && ! -L /opt/jarvis/current ]]
else
  bound_mapping="/var/lib/jarvis-cutover/held/mapping-$change.json"
  if [[ ! -f "$bound_mapping" ]]; then bound_mapping=/etc/jarvis/codex-host.json; fi
  cmp -s "$remote/codex-host.json" "$bound_mapping" || {
    printf 'native mapping differs from the held release input\n' >&2
    exit 1
  }
fi
candidate="$(sudo -n mktemp /etc/jarvis/.codex-host.XXXXXX)"
trap 'sudo -n rm -f -- "$candidate"; cleanup' EXIT HUP INT TERM
sudo -n install -m 0644 -o root -g root "$remote/codex-host.json" "$candidate"
mapfile -t layout < <("$release/.venv/bin/python" - "$candidate" <<'PYCODE'
import sys
from pathlib import Path

from jarvis.codex_config import CodexHostConfig
mapping = CodexHostConfig.load(Path(sys.argv[1]))
print(mapping.personal.host_user)
print(mapping.binary)
print(mapping.personal.host_user)
print(mapping.personal.account_home)
print(mapping.google_neon.host_user)
print(mapping.google_neon.host_home)
print(mapping.agy_neon.host_user)
print(mapping.agy_neon.host_home)
PYCODE
)
[[ "${#layout[@]}" == 8 ]]
host_user="${layout[0]}"
agy_user="${layout[6]}"
[[ "${layout[7]}" == /run/jarvis-agy-host/home ]]
getent group jarvis-agy-control >/dev/null || sudo -n groupadd --system jarvis-agy-control
if ! id "$agy_user" >/dev/null 2>&1; then
  sudo -n useradd --system --gid jarvis-agy-control --no-create-home \
    --home-dir "${layout[7]}" --shell /usr/sbin/nologin "$agy_user"
fi
[[ "$(id -Gn "$agy_user")" == jarvis-agy-control ]]
sudo -n env "JARVIS_CODEX_HOST_CONFIG_PATH=$candidate" \
  "$release/.venv/bin/python" "$release/deploy/codex-host" render "$remote"
for ((i=2; i<6; i+=2)); do
  account_user="${layout[i]}"
  account_home="${layout[i+1]}"
  if ((i == 2)); then
    sudo -n -u "$account_user" test -r "$account_home/auth.json"
  else
    sudo -n test ! -e "$account_home/auth.json"
  fi
  sudo -n -u jarvis test ! -r "$account_home/auth.json"
  for ((j=2; j<${#layout[@]}; j+=2)); do
    if ((i != j)); then
      sudo -n -u "${layout[j]}" test ! -x "$account_home"
    fi
  done
done
units=()
sudo -n install -d -o root -g root -m 0700 /etc/jarvis/credentials
sudo -n "$release/.venv/bin/python" - "$candidate" <<'PYCODE'
import os
import secrets
import stat
import sys
from pathlib import Path

from jarvis.codex_config import CodexHostConfig

mapping = CodexHostConfig.load(Path(sys.argv[1]))
directory = Path("/etc/jarvis/credentials")
credential = directory / mapping.google_neon.credential_name
metadata = credential.lstat()
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != 0
    or stat.S_IMODE(metadata.st_mode) != 0o600
):
    raise SystemExit("Gemini API credential must be a root-owned mode 0600 file")
for name, content in (
    ("neon-stock-bearer", secrets.token_hex(32).encode("ascii") + b"\n"),
    ("neon-continuation-key", secrets.token_bytes(32)),
):
    path = directory / name
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        metadata = path.lstat()
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or metadata.st_size != len(content)
        ):
            raise SystemExit(f"{name} must be a root-owned mode 0600 credential")
    else:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
PYCODE
for unit in "${NATIVE_HOST_UNITS[@]}"; do units+=("$remote/$unit"); done
sed "s|/opt/jarvis/current|$release|g" "$release/deploy/jarvis.service" >"$remote/jarvis.service"
getent group jarvis-neon-control >/dev/null || sudo -n groupadd --system jarvis-neon-control
sudo -n systemd-analyze verify "${units[@]}" "$remote/jarvis.service"
[[ "$(cat /sys/module/apparmor/parameters/enabled)" == Y ]]
[[ "$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" == 1 ]]
sudo -n apparmor_parser --skip-kernel-load "$remote/jarvis-antigravity-localharness"
if [[ "$change" != bootstrap ]]; then
  "$release/deploy/cutover-hold" close-native "$change"
  if sudo -n grep -q '^JARVIS_CODEX_PROFILE_KEY=' /etc/jarvis/jarvis.env; then
    printf 'remove the retired JARVIS_CODEX_PROFILE_KEY under stopped custody before publication\n' >&2
    exit 1
  fi

fi
if [[ "$change" == bootstrap ]]; then
  # This installer owns only the dedicated production distribution, never an account's CLI.
  stock_version=0.171.0
  stock_dir="/opt/jarvis-codex/$stock_version"
  if [[ "$(uname -m)" != x86_64 || "${layout[1]}" != "$stock_dir/bin/codex" ||
        "$(realpath -m -- "${layout[1]}")" != "${layout[1]}" ]]; then
    echo "map the dedicated x86-64 host binary $stock_dir/bin/codex before installing" >&2
    exit 1
  fi
  sudo -n systemd-analyze verify "$remote/jarvis-notes-bootstrap.service"
  for unit in "${NATIVE_HOST_UNITS[@]}"; do
    if sudo -n systemctl cat "$unit" >/dev/null 2>&1; then
      sudo -n systemctl stop "$unit"
    fi
  done
  # Keep the vendor layout so stock locates its sandbox, tools and companion.
  executables=(bin/codex bin/codex-code-mode-host codex-resources/bwrap codex-path/rg)
  cat >"$remote/stock.sha256" <<'SUMS'
b76a027d6b210f9a8da7aaf321dd235c700f0ef7a794d4a5314b9af6c134f0f0  bin/codex
f49bd4f0c0cc73cf1ec3a719009e07ce5b6e100520d023c760cc203fb37e5c6f  bin/codex-code-mode-host
91a245ea678a7ae642f383a22576c3c476d0d6d3e2321a553f3ed8d4d487ed74  codex-resources/bwrap
e62198eb19b136b88c330af83647b5a962cb99b6b1f066758568f12de1974849  codex-path/rg
2e6a51972124359dbff670b008845d778dbf43d3cc9882c220a7e7f09f1a545d  codex-package.json
SUMS
  verify_stock() (
    cd "$1" && sha256sum -c --status "$remote/stock.sha256" || exit 1
    for file in "${executables[@]}"; do test -x "$file" || exit 1; done
  )
  if ! verify_stock "$stock_dir" 2>/dev/null; then
    curl -fsSL "https://registry.npmjs.org/@openai/codex/-/codex-$stock_version-linux-x64.tgz" -o "$remote/stock.tgz"
    printf 'e13d67afb0533cc6160b5f4140e4ad07e2acd87adbaa081bbf69b82e90cf4e55  %s\n' "$remote/stock.tgz" | sha256sum -c --status
    tar -xzf "$remote/stock.tgz" -C "$remote"
    vendor="$remote/package/vendor/x86_64-unknown-linux-musl"
    verify_stock "$vendor"
    for file in "${executables[@]}"; do
      install -D -m 0755 -o root -g root "$vendor/$file" "$stock_dir/$file"
    done
    install -m 0644 -o root -g root "$vendor/codex-package.json" "$stock_dir/"
    verify_stock "$stock_dir"
  fi
  sudo -n install -d -m 02750 -o jarvis -g codex-clients /run/jarvis-codex-cognition
  sudo -n install -d -m 0750 -o jarvis -g codex-clients \
    /var/cache/jarvis /var/cache/jarvis/attachments
  if ! sudo -n test -e /var/lib/jarvis-notes; then
    sudo -n install -d -m 02750 -o "$host_user" -g codex-clients /var/lib/jarvis-notes
  fi
  bootstrap_unit=/run/systemd/system/jarvis-notes-bootstrap.service
  [[ ! -e "$bootstrap_unit" && ! -L "$bootstrap_unit" ]]
  cleanup_candidate() {
    sudo -n systemctl stop jarvis-notes-bootstrap.service >/dev/null 2>&1 || true
    sudo -n rm -f -- "$candidate" "$bootstrap_unit"
    sudo -n systemctl daemon-reload
    cleanup
  }
  trap cleanup_candidate EXIT HUP INT TERM
  sudo -n install -m 0644 -o root -g root "$remote/jarvis-notes-bootstrap.service" "$bootstrap_unit"
  sudo -n systemctl daemon-reload
  sudo -n systemctl start jarvis-notes-bootstrap.service
  sudo -n systemctl stop jarvis-notes-bootstrap.service
  sudo -n rm -f -- "$bootstrap_unit"
  for area in jarvis-pages jarvis-mail; do
    if [[ ! -d /var/lib/jarvis-notes/.git/$area ]]; then
      sudo -n install -d -m 0750 -o "$host_user" -g codex-clients "/var/lib/jarvis-notes/.git/$area"
    fi
  done
  if [[ ! -d /var/lib/jarvis-notes/.git/jarvis-mail/incoming ]]; then
    sudo -n install -d -m 0700 -o "$host_user" -g codex-clients /var/lib/jarvis-notes/.git/jarvis-mail/incoming
  fi
  sudo -n install -d -m 0700 -o jarvis -g jarvis /var/lib/jarvis/mail-stage
  sudo -n -u jarvis -g codex-clients test -r /var/lib/jarvis-notes
  sudo -n -u jarvis -g codex-clients test -x /var/lib/jarvis-notes
  sudo -n -u jarvis -g codex-clients test -r /var/lib/jarvis-notes/.git
  sudo -n -u jarvis -g codex-clients test -x /var/lib/jarvis-notes/.git
  printf '%s\n' \
    'd /run/jarvis-codex-cognition 2750 jarvis codex-clients -' \
    'e /var/lib/jarvis-notes/.git/jarvis-mail - - - 24h' \
    'X /var/lib/jarvis-notes/.git/jarvis-mail/incoming - - - -' | \
    sudo -n tee /etc/tmpfiles.d/jarvis-codex-contained.conf >/dev/null
fi
notes=/var/lib/jarvis-notes
incoming="$notes/.git/jarvis-mail/incoming"
# Add only the new writer to the existing access and inheritance policy.
sudo -n find "$notes" -path "$incoming" -prune -o -type d \
  -exec setfacl -n -m "u:$agy_user:rwx,d:u:$agy_user:rwx" -- {} +
sudo -n find "$notes" -path "$incoming" -prune -o -type f -path "$notes/.git/objects/*" \
  -exec setfacl -n -m "u:$agy_user:r--" -- {} +
sudo -n find "$notes" -path "$incoming" -prune -o -type f ! -path "$notes/.git/objects/*" \
  -exec setfacl -n -m "u:$agy_user:rwX" -- {} +
sudo -n setfacl -n -m "u:$agy_user:rwx" -- "$incoming"
primary_author=
primary_committer=
for ((i=2; i<${#layout[@]}; i+=2)); do
  account_user="${layout[i]}"
  sudo -n -u "$account_user" -g codex-clients test -w "$incoming"
  sudo -n -u "$account_user" -g codex-clients test -x "$incoming"
  # Git object data is immutable. Its directories need write access for new objects.
  denied="$(cd / && sudo -n -u "$account_user" -g codex-clients find "$notes" \
    -path "$incoming" -prune -o \
    \( -type d \( ! -readable -o ! -writable -o ! -executable \) -o \
       -type f \( ! -readable -o \( ! -path "$notes/.git/objects/*" -a ! -writable \) \) \) \
    -print -quit)"
  if [[ -n "$denied" ]]; then
    printf 'an existing notes path lacks native writer access for %s\n' "$account_user" >&2
    exit 1
  fi
  # The SDK host uses the same checkout identity with an offline Git policy.
  if [[ "$account_user" == "$agy_user" ]]; then continue; fi
  sudo -n -H -u "$account_user" -g codex-clients git -C "$notes" rev-parse --show-toplevel >/dev/null
  author="$(sudo -n -H -u "$account_user" -g codex-clients git -C "$notes" var GIT_AUTHOR_IDENT)"
  committer="$(sudo -n -H -u "$account_user" -g codex-clients git -C "$notes" var GIT_COMMITTER_IDENT)"
  # git var appends a timestamp and time zone to the actual identity.
  author="${author% *}"; author="${author% *}"
  committer="${committer% *}"; committer="${committer% *}"
  if ((i == 2)); then
    primary_author="$author"
    primary_committer="$committer"
  elif [[ "$author" != "$primary_author" || "$committer" != "$primary_committer" ]]; then
    printf 'native Git author or committer differs from the primary\n' >&2
    exit 1
  fi
  sudo -n -H -u "$account_user" -g codex-clients \
    timeout 60s git -C "$notes" ls-remote --exit-code origin refs/heads/main >/dev/null
done
denied="$(cd / && sudo -n -u jarvis -g codex-clients find "$notes" \
  -path "$incoming" -prune -o \
  \( -type d \( ! -readable -o -writable -o ! -executable \) -o \
     -type f \( ! -readable -o -writable \) \) \
  -print -quit)"
if [[ -n "$denied" ]]; then
  printf 'an existing notes path violates the application reader access\n' >&2
  exit 1
fi
sudo -n -u jarvis -g codex-clients test ! -x "$incoming"

# Existing access ACLs do not establish the permissions of the next write.
# Use the native service umask and check the actual inherited writer/reader grant.
sudo -n env "JARVIS_CODEX_HOST_CONFIG_PATH=$candidate" \
  "$release/.venv/bin/python" "$release/deploy/codex-host" verify-notes-acl
for directory in "$notes" "$notes/.git" "$notes/.git/objects" "$notes/.git/refs" \
  "$notes/.git/jarvis-pages" "$notes/.git/jarvis-mail"; do
  for ((i=2; i<${#layout[@]}; i+=2)); do
    probe_file="$directory/.jarvis-native-acl-$(cat /proc/sys/kernel/random/uuid)"
    sudo -n -u "${layout[i]}" -g codex-clients bash -c 'umask 077; set -C; : > "$1"' acl-probe "$probe_file"
    for ((j=2; j<${#layout[@]}; j+=2)); do
      if ! sudo -n -u "${layout[j]}" -g codex-clients test -r "$probe_file" ||
          ! sudo -n -u "${layout[j]}" -g codex-clients test -w "$probe_file"; then
        printf 'a new notes file lacks the inherited native writer ACL\n' >&2
        exit 1
      fi
    done
    if ! sudo -n -u jarvis -g codex-clients test -r "$probe_file" ||
        sudo -n -u jarvis -g codex-clients test -w "$probe_file"; then
      printf 'a new notes file lacks the inherited application reader ACL\n' >&2
      exit 1
    fi
    rm -f -- "$probe_file"
    probe_file=
  done
done

# The injected file contains only checkout identity and the exact safe directory.
"$release/.venv/bin/python" - "$remote/antigravity-gitconfig" "$notes" "$primary_author" "$primary_committer" <<'PYCODE'
import re
import subprocess
import sys

output, notes, author, committer = sys.argv[1:]
for key, value in (("safe.directory", notes), ("credential.helper", "")):
    subprocess.run(["git", "config", "--file", output, key, value], check=True)
for kind, identity in (("author", author), ("committer", committer)):
    match = re.fullmatch(r"(.+) <([^<>]+)>", identity)
    if match is None:
        raise SystemExit("missing checkout Git identity")
    for key, value in (("name", match[1]), ("email", match[2])):
        subprocess.run(["git", "config", "--file", output, kind + "." + key, value], check=True)
PYCODE

# Only the existing named hold (or virgin bootstrap) may publish the staged layout.
stock_paid_unit="${CODEX_HOST_UNITS[1]}"
declare -A optional_states
for unit in "$stock_paid_unit" "$AGY_HOST_UNIT"; do
  optional_states[$unit]="$(systemctl is-enabled "$unit" 2>/dev/null || true)"
  if [[ "$(systemctl show -p LoadState --value "$unit")" == not-found ]]; then
    optional_states[$unit]=
  fi
done
sudo -n install -m 0644 -o root -g root "$remote/codex-neon-requirements.toml" \
  /etc/jarvis/codex-neon-requirements.toml
sudo -n install -m 0644 -o root -g root "$remote/antigravity-gitconfig" \
  /etc/jarvis/antigravity-gitconfig
sudo -n install -m 0644 -o root -g root "$remote/jarvis-antigravity-localharness" \
  /etc/apparmor.d/jarvis-antigravity-localharness
sudo -n apparmor_parser -r /etc/apparmor.d/jarvis-antigravity-localharness
sudo -n grep -qFx 'jarvis-antigravity-localharness (unconfined)' /sys/kernel/security/apparmor/profiles
sudo -n -u "$agy_user" -g codex-clients env GIT_CONFIG_GLOBAL=/etc/jarvis/antigravity-gitconfig \
  git -C "$notes" rev-parse --show-toplevel >/dev/null
sudo -n mv -fT -- "$candidate" /etc/jarvis/codex-host.json
for unit in "${NATIVE_HOST_UNITS[@]}"; do
  case "${optional_states[$unit]:-}" in masked|masked-runtime) continue ;; esac
  sudo -n install -m 0644 -o root -g root "$remote/$unit" "/etc/systemd/system/$unit"
done
sync -f /etc/jarvis /etc/systemd/system /etc/apparmor.d
sudo -n systemctl daemon-reload
sudo -n systemctl enable "${CODEX_HOST_UNITS[0]}"
if [[ "$change" != bootstrap ]]; then
  "$release/deploy/cutover-hold" open-native "$change"
fi
sudo -n systemctl start "${CODEX_HOST_UNITS[0]}"
verify_native_account "$release" personal
for unit in "$stock_paid_unit" "$AGY_HOST_UNIT"; do
  case "${optional_states[$unit]}" in
    masked|masked-runtime|disabled)
      printf '%s retains its operator-disabled state\n' "$unit"
      continue
      ;;
    "") sudo -n systemctl enable "$unit" ;;
  esac
  if sudo -n systemctl start "$unit"; then
    if [[ "$unit" == "$AGY_HOST_UNIT" ]]; then
      verify_agy_endpoint "$release" && continue
    elif systemctl is-active --quiet "$NEON_GATEWAY_UNIT" &&
         verify_native_account "$release" google_neon; then
      continue
    fi
  fi
  sudo -n systemctl stop "$unit"
  printf '%s unavailable; personal binding remains qualified\n' "$unit" >&2
done
printf 'contained binding installation completed for %s; jarvis remains stopped\n' "$commit"
